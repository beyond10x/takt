digraph cluster_delivery {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.35, ranksep=0.7, bgcolor="white", pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#f4f6f8", color="#5b6b7a"];
  edge  [fontname="Helvetica", fontsize=10, color="#5b6b7a"];

  subgraph cluster_host {
    label="operator's machine"; style="rounded"; color="#9aa7b4"; fontcolor="#33414e";

    kubectl [label="kubectl apply\nLoomAgent per run", fillcolor="#ffffff"];

    subgraph cluster_kind {
      label="kind cluster"; style="rounded,filled"; fillcolor="#eef3f8"; color="#7c93ab";

      subgraph cluster_ns {
        label="namespace loom-agents"; style="rounded,filled"; fillcolor="#e3ecf5"; color="#7c93ab";

        operator [label="Loom operator\n(chart loom-agents)", fillcolor="#dbe7f3"];
        cr [label="LoomAgent\nCommand variant", shape=note, fillcolor="#ffffff"];
        netpol [label="NetworkPolicy\nDNS + egress 443", shape=note, fillcolor="#ffffff"];

        subgraph cluster_job {
          label="Job: one run, restartPolicy Never"; style="rounded,filled"; fillcolor="#fdf6e3"; color="#c9a227";

          init [label="init containers\nb10x-loom agent stage-files\nb10x-loom agent prepare-dirs", fillcolor="#fff9e8"];
          takt [label="takt run --story <id>\nstory.delivery/2\ntoken stop per run", fillcolor="#ffe9a8", penwidth=1.6];
          harness [label="b10x-harness\nmodel session", fillcolor="#fff9e8"];
          checks [label="tests + gates\ncargo", fillcolor="#fff9e8"];
          forge [label="connectors forge\nconnectors operations invoke", fillcolor="#fff9e8"];
        }

        envsecret [label="Secret (env)\nmodel API key", shape=cylinder, fillcolor="#f9e0e0", color="#b05050"];
        instance [label="Connectors instance\nGitHub connector,\nApp key", fillcolor="#f9e0e0", color="#b05050"];
        pvc [label="PVC workspace\nclone of the target repository\ncases under .takt/cases", shape=cylinder, fillcolor="#e6f2e6", color="#4f8a4f"];
      }
    }
  }

  subgraph cluster_ext {
    label="internet"; style="rounded"; color="#9aa7b4"; fontcolor="#33414e";
    model [label="model endpoint\nOpenAI-compatible", fillcolor="#ffffff"];
    crates [label="crates.io\nindex + static", fillcolor="#ffffff"];
    subgraph cluster_gh {
      label="github.com/beyond10x"; style="rounded,filled"; fillcolor="#f2f2f2"; color="#8a8a8a";
      repoA [label="takt\nAEP store: ready stories", fillcolor="#ffffff"];
      repoB [label="llm\nAEP store: ready stories", fillcolor="#ffffff"];
      pr [label="pull request\nby the GitHub App\nCI checks, merge to main", fillcolor="#ffffff"];
    }
  }

  kubectl -> cr [label="apply"];
  operator -> cr [label="watch", dir=back];
  operator -> init [label="renders Job"];
  operator -> netpol [label="renders"];
  init -> takt [label="config files,\nprivate dirs"];
  envsecret -> takt [label="env", style=dashed];
  forge -> instance [label="open, read,\nmerge"];
  pvc -> takt [label="/workspace"];
  takt -> harness [label="judgement step"];
  takt -> checks [label="tests.run,\ngate"];
  takt -> forge [label="pr.opened,\nrepository.merge"];
  harness -> model [label="HTTPS"];
  checks -> crates [label="cargo fetch"];
  repoA -> pvc [label="clone", style=dotted];
  repoB -> pvc [label="clone", style=dotted];
  forge -> pr [label="push branch"];
  instance -> pr [label="open, read, merge"];
}
