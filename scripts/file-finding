#!/usr/bin/env bash
# file-finding: file a finding in this repository's planning store, as a draft story or an open
# blocker, carrying its `expected_before` predicate, the run record or review it came from, and
# the reference `finding:<key>`. A key already in the store is refused, and so is a finding whose
# predicate does not parse; in both cases nothing is written. The store is written only through
# `aep plan artifact new`.
#
#   file-finding --key <key> --title <title> --from <body.md> [--kind story|blocker] [--repo <dir>]
#   file-finding --predicate <body.md>
#
# The body is the artifact's whole markdown body. It holds exactly one fenced block whose info
# string is `expected_before`, one `key: value` a line:
#
#   ```expected_before
#   scenario: 1
#   command: "$TAKT" run --repo . --harness none --forge none --iterations 1
#   exit: 3
#   healthy_exit: 3
#   output: on software.change/1
#   source: docs/runs/trial-1.md
#   ```
#
#   scenario    the scenario's id, as `.engineering/scenarios.conf` of the scenario repository
#               declares it (letters, digits, `-` and `_`)
#   repository  instead of a scenario: the repository the defect was seen on, an `https://` URL
#               and nothing else (a predicate is committed to a public repository, and a path is
#               one machine's), cloned by `scripts/check-finding` at `seed`; a local checkout
#               stands in for the URL only through that script's `--checkout` option. A filed
#               repository names a public host: a dotted DNS name (labels of letters, digits and
#               `-`, at least one dot, no trailing dot, not `localhost` or a name under it) or a
#               dotted-decimal IPv4 address (four decimal octets, 0 to 255, no leading zero, no
#               hex, no shorthand) outside the zero, loopback, private, link-local and shared
#               ranges; no IPv6 literal. The check is a lint on the URL's text, not a boundary
#   seed        with `repository`: the commit the task starts from, a commit id of 7 to 64 hex
#               digits
#   test        with `repository`, optional: the task's test command, handed to the command as
#               `$TEST`
#   command     one shell line, run by `scripts/check-finding` in a fresh checkout of the
#               scenario's seed, or of `repository` at `seed`, with `$TAKT` the takt binary
#               under test and `$SCENARIO` the checkout; it runs `$TAKT` (or `${TAKT}`), or its
#               result could not depend on the revision
#   exit        the exit status the command gives while the defect is present, 0 to 255 but 124
#               and 137, which `scripts/check-finding` reads as its timeout
#   healthy_exit
#               optional: the exit status the command gives once the defect is gone, 0 when
#               not given, 0 to 255 but 124 and 137; `scripts/check-finding` says
#               `not_reproduced` only for this status, and `error` for one the predicate names
#               neither here nor as `exit`
#   output      a fixed string its standard output or standard error then holds, at least 8
#               characters
#   source      the run record or review that produced the finding, a path relative to the
#               repository that exists
#
# `scenario` or `repository`, one of the two; `exit`, `output` or both; the predicate holds when
# every one given does. An `exit` that is the healthy exit needs `output`: the status alone
# cannot tell the defect from its fix.
#
# Standard output is one line, the result of the `finding_record` evidence kind
# (protocols/self-improvement/1.yaml): `filed` (exit 0) or `malformed` (exit 2). Everything else
# goes to standard error. A key already filed exits 3, a usage error 64, any other failure 1;
# those print nothing on standard output. `--predicate` prints the block's entries, one
# `key<TAB>value` a line, for `scripts/check-finding`, or `malformed`.
#
# The body is read once; the text whose predicate was parsed is the text `aep` files, through
# its standard input. The check for the key and the write hold `flock` on `file-finding.lock`
# in the repository's git directory, so two filings of one key cannot both pass the check;
# without `flock` the script refuses to file.
set -euo pipefail

say() { printf 'file-finding: %s\n' "$*" >&2; }
usage() {
    say "$*"
    say "usage: file-finding --key <key> --title <title> --from <body.md> [--kind story|blocker] [--repo <dir>]"
    say "       file-finding --predicate <body.md>"
    exit 64
}
malformed() {
    say "malformed: $*"
    printf 'malformed\n'
    exit 2
}

# Sets BODY to the whole text of the file $1, trailing newlines kept.
BODY=
read_body() {
    local text
    text=$(cat -- "$1" && printf x) || return 1
    BODY=${text%x}
}

# Reads the `expected_before` block of the body text $1 into the associative array PREDICATE,
# or refuses the finding as malformed.
declare -A PREDICATE=()
read_predicate() {
    local text=$1 fence='```' line inside=0 blocks=0 key value
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        if ((!inside)); then
            if [[ $line == "${fence}expected_before" ]]; then
                blocks=$((blocks + 1))
                inside=1
            fi
            continue
        fi
        if [[ $line == "$fence" ]]; then
            inside=0
            continue
        fi
        ((blocks > 1)) && continue
        [[ -z ${line//[[:space:]]/} ]] && continue
        [[ $line =~ ^([a-z_]+):(.*)$ ]] || malformed "\`$line\` in the expected_before block is no \`key: value\`"
        key=${BASH_REMATCH[1]}
        value=${BASH_REMATCH[2]}
        value=${value#"${value%%[![:space:]]*}"}
        value=${value%"${value##*[![:space:]]}"}
        case $key in
        scenario | repository | seed | test | command | exit | healthy_exit | output | source) ;;
        *) malformed "the expected_before block gives \`$key\`, which nothing reads; it gives scenario or repository, seed and test, command, exit, healthy_exit, output and source" ;;
        esac
        [[ -v PREDICATE[$key] ]] && malformed "the expected_before block gives \`$key\` twice"
        [[ -n $value ]] || malformed "the expected_before block gives \`$key\` no value"
        PREDICATE[$key]=$value
    done < <(printf '%s' "$text")
    ((blocks > 0)) || malformed "the body holds no \`${fence}expected_before\` block: a finding without a predicate a machine can check is a note"
    ((blocks == 1)) || malformed "the body holds $blocks expected_before blocks; a finding has one predicate"
    ((!inside)) || malformed "the expected_before block is never closed"
    local name
    for name in command source; do
        [[ -v PREDICATE[$name] ]] || malformed "the expected_before block gives no \`$name\`"
    done
    # The command runs the takt under test, `$TAKT` or `${TAKT}` in its text; one that never
    # names it gives the same result at every revision, so it shows nothing about any of them.
    local runs_takt='\$(TAKT([^A-Za-z0-9_]|$)|\{TAKT\})'
    [[ ${PREDICATE[command]} =~ $runs_takt ]] ||
        malformed "the command never runs \`\$TAKT\`, the takt under test, so its result would be the same at every revision; run it"
    # One form: a scenario the scenario repository declares, or a repository and a seed the
    # predicate names itself.
    if [[ -v PREDICATE[scenario] && -v PREDICATE[repository] ]]; then
        malformed "the expected_before block gives both \`scenario\` and \`repository\`; a predicate runs on one of them"
    elif [[ -v PREDICATE[scenario] ]]; then
        [[ ${PREDICATE[scenario]} =~ ^[A-Za-z0-9_-]+$ ]] ||
            malformed "scenario \`${PREDICATE[scenario]}\`: a scenario id is letters, digits, \`-\` and \`_\`"
        for name in seed test; do
            [[ -v PREDICATE[$name] ]] &&
                malformed "the expected_before block gives \`$name\` with a scenario; \`$name\` goes with \`repository\`, whose seed the scenario repository declares"
        done
    elif [[ -v PREDICATE[repository] ]]; then
        case ${PREDICATE[repository]} in
        https://*@*) malformed "repository \`${PREDICATE[repository]}\`: a repository URL carries no user or credential; the check clones with none" ;;
        https://?*) ;;
        *) malformed "repository \`${PREDICATE[repository]}\`: a repository is an \`https://\` URL, which the check clones with no credential of its own and which holds on every machine; a local checkout stands in for it through check-finding's \`--checkout <url>=<path>\`" ;;
        esac
        # The host, between `https://` and the next `/`, less a port. A filed repository names
        # a public host: a dotted DNS name (labels of letters, digits and `-`, at least one dot,
        # no trailing dot, not `localhost` or a name under it) or a dotted-decimal IPv4 address
        # (four decimal octets, 0 to 255, no leading zero, no hex, no shorthand) outside the
        # zero, loopback, private, link-local and shared ranges; no IPv6 literal. A host whose
        # last label is a number is read as an address, as a browser reads it, so no hex, octal
        # or shorthand spelling of a loopback passes as a name. This is a lint on the URL's
        # text, not a boundary: the predicate's own command reaches whatever it names.
        local host=${PREDICATE[repository]#https://} why= last
        local octet='(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])'
        host=${host%%/*}
        case $host in
        *[?#\\]*) why="a host holds no \`?\`, \`#\` or \`\\\`" ;;
        \[*) why="an IPv6 literal is no host every machine reaches by that text" ;;
        *) host=${host%%:*} ;;
        esac
        last=${host##*.}
        if [[ -n $why ]]; then
            :
        elif [[ -z $host ]]; then
            why="the URL names no host"
        elif [[ $host == *. ]]; then
            why="a host ends in no dot"
        elif [[ ${host,,} == localhost || ${host,,} == *.localhost ]]; then
            why="\`localhost\` and the names under it are one machine's"
        elif [[ ${last,,} =~ ^(0x[0-9a-f]*|[0-9]+)$ ]]; then
            if [[ ! $host =~ ^$octet(\.$octet){3}$ ]]; then
                why="an address is dotted decimal: four octets, 0 to 255, no leading zero, no hex, no shorthand"
            else
                case $host in
                0.* | 10.* | 127.* | 169.254.* | 192.168.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[01].* | 100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*)
                    why="the zero, loopback, private, link-local and shared address ranges are one machine's or one network's" ;;
                esac
            fi
        elif [[ ! $host =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$ ]]; then
            why="a name is labels of letters, digits and \`-\`, with at least one dot"
        fi
        [[ -z $why ]] ||
            malformed "repository \`${PREDICATE[repository]}\`: its host \`$host\` names no public repository ($why); a repository is one every machine reaches, a local checkout standing in for it through check-finding's \`--checkout <url>=<path>\`"
        [[ -v PREDICATE[seed] ]] || malformed "the expected_before block gives \`repository\` but no \`seed\`: the commit the task starts from"
        [[ ${PREDICATE[seed]} =~ ^[0-9a-f]{7,64}$ ]] ||
            malformed "seed \`${PREDICATE[seed]}\`: a seed is a commit id, 7 to 64 hex digits, so the check starts from the same tree every time"
    else
        malformed "the expected_before block gives neither \`scenario\` nor \`repository\`: nothing to run the command on"
    fi
    [[ -v PREDICATE[exit] || -v PREDICATE[output] ]] ||
        malformed "the expected_before block gives neither \`exit\` nor \`output\`: nothing to check the command against"
    # A fixed string of a few characters turns up in almost any output.
    if [[ -v PREDICATE[output] ]] && ((${#PREDICATE[output]} < 8)); then
        malformed "output \`${PREDICATE[output]}\` is ${#PREDICATE[output]} characters; an output is at least 8, so it does not turn up in any output by chance"
    fi
    for name in exit healthy_exit; do
        [[ -v PREDICATE[$name] ]] || continue
        [[ ${PREDICATE[$name]} =~ ^[0-9]{1,3}$ ]] && ((10#${PREDICATE[$name]} <= 255)) ||
            malformed "$name \`${PREDICATE[$name]}\` is no exit status, 0 to 255"
        case $((10#${PREDICATE[$name]})) in
        124 | 137) malformed "$name \`${PREDICATE[$name]}\` is what scripts/check-finding reads as its timeout, so the check could never give a result; name another status, or the output" ;;
        esac
    done
    # The healthy exit is the one status `scripts/check-finding` reads as the defect gone; an
    # `exit` equal to it tells the defect from its fix only by the output.
    local healthy=$((10#${PREDICATE[healthy_exit]:-0}))
    if [[ -v PREDICATE[exit] && ! -v PREDICATE[output] ]] && ((10#${PREDICATE[exit]} == healthy)); then
        malformed "exit \`${PREDICATE[exit]}\` is the healthy exit too (healthy_exit, 0 when not given), and with no \`output\` the check could never tell the defect from its fix; give the output, or the status the command gives once the defect is gone as healthy_exit"
    fi
}

key= key_given= title= from= kind=story repo= predicate_only=
while (($#)); do
    case $1 in
    --key | --title | --from | --kind | --repo | --predicate)
        (($# >= 2)) || usage "$1 takes a value"
        case $1 in
        --key) key=$2 key_given=1 ;;
        --title) title=$2 ;;
        --from) from=$2 ;;
        --kind) kind=$2 ;;
        --repo) repo=$2 ;;
        --predicate) predicate_only=$2 ;;
        esac
        shift 2
        ;;
    -h | --help)
        sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"
        exit 0
        ;;
    *) usage "unexpected argument \`$1\`" ;;
    esac
done

if [[ -n $predicate_only ]]; then
    [[ -f $predicate_only && -r $predicate_only ]] || usage "--predicate $predicate_only: no readable file"
    read_body "$predicate_only" || usage "--predicate $predicate_only: unreadable"
    read_predicate "$BODY"
    for name in scenario repository seed test command exit healthy_exit output source; do
        [[ -v PREDICATE[$name] ]] && printf '%s\t%s\n' "$name" "${PREDICATE[$name]}"
    done
    exit 0
fi

[[ -n $key_given ]] || usage "--key is required"
[[ -n $title ]] || usage "--title is required"
[[ -n $from ]] || usage "--from is required"
[[ $kind == story || $kind == blocker ]] || usage "--kind $kind: a finding is filed as a story or a blocker"
[[ -f $from && -r $from ]] || usage "--from $from: no readable file"
# Absolute before any `cd`, and read once: what is parsed is what is filed.
from=$(realpath -e -- "$from") || usage "--from $from: does not resolve"
read_body "$from" || usage "--from $from: unreadable"
text=$BODY
if [[ -z $repo ]]; then
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || usage "not inside a repository; give --repo"
fi
repo=$(cd "$repo" && pwd -P) || usage "--repo $repo: no directory"

[[ $key =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
    malformed "key \`$key\`: a finding key is lower-case letters and digits in words joined by \`-\`"
read_predicate "$text"

# The source is a path of this repository, relative, that exists and stays inside it.
source=${PREDICATE[source]}
[[ $source != /* ]] || malformed "source \`$source\` is absolute; it is a path relative to the repository"
case /$source/ in
*/../*) malformed "source \`$source\` climbs out of the repository" ;;
esac
[[ -e $repo/$source ]] || malformed "source \`$source\` does not exist in $repo"
resolved=$(realpath -e -- "$repo/$source") || malformed "source \`$source\` does not resolve"
[[ $resolved == "$repo" || $resolved == "$repo"/* ]] ||
    malformed "source \`$source\` resolves outside the repository"

cd "$repo"
# `aep plan artifact new` accepts a second artifact with the same reference, so the refusal is
# this script's: whatever kind holds the key already, the key is filed. The check and the write
# hold one lock, so no other filing comes between them.
command -v flock >/dev/null 2>&1 || {
    say "flock is missing, and without it a second filing of finding:$key could pass the check; nothing was written"
    exit 1
}
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
    say "$repo has no git directory to hold the filing lock; nothing was written"
    exit 1
}
exec 9>>"$common/file-finding.lock"
flock -w 120 9 || {
    say "another filing held $common/file-finding.lock for 120 s; nothing was written"
    exit 1
}
held=$(aep plan artifact list --ref "finding:$key") || {
    say "aep plan artifact list --ref finding:$key failed; nothing was written"
    exit 1
}
if [[ -n $held ]]; then
    say "finding:$key is filed already, as $(printf '%s\n' "$held" | awk 'NF { printf "%s%s", sep, $1; sep = ", " }'); nothing was written"
    exit 3
fi
printf '%s' "$text" |
    aep plan artifact new "$kind" "$key" --title "$title" --ref "finding:$key" --tag finding --from - >&2 || {
    say "aep plan artifact new $kind $key failed"
    exit 1
}
say "filed $kind:$key (finding:$key), source $source"
printf 'filed\n'
