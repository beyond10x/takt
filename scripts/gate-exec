#!/bin/sh
# gate-exec <tool> [<arg>...]: runs one command of takt's gates document
# (.engineering/gates.yaml). The gate runs it with the environment cleared and no PATH;
# takt's gate validator sets CARGO_HOME to the invoking user's Cargo home. The tool is looked
# up on the system directories first, then that home's bin directory, so a file in the
# user-writable Cargo bin cannot shadow python3 or another system tool; rustup's cargo proxy
# in the system directories still resolves the toolchain, and ess is found in the Cargo bin.
# A tool that resolves, after symlinks, inside this repository is refused. That is all this
# script vouches for: cargo clippy compiles and runs build code the step wrote, so the gate
# cannot vouch for code that runs at build time; the merge of such a change stays guarded by
# the owner. Exits with the tool's status, or 2 for a usage error, 126 for a refused tool and
# 127 for a tool not found.
set -eu

if [ "$#" -eq 0 ]; then
    echo "gate-exec: no tool named" >&2
    exit 2
fi

system=/usr/local/bin:/usr/bin:/bin
case "${CARGO_HOME-}" in
    "") PATH=$system ;;
    /*) PATH=$system:$CARGO_HOME/bin ;;
    *)
        echo "gate-exec: CARGO_HOME is not an absolute path: $CARGO_HOME" >&2
        exit 2
        ;;
esac
export PATH

root=$(cd -P "$(dirname "$0")/.." && pwd -P)
name=$1
shift

if ! tool=$(command -v "$name"); then
    echo "gate-exec: $name: not found on $PATH" >&2
    exit 127
fi
case "$tool" in
    /*) ;;
    *)
        echo "gate-exec: $name: not a program on $PATH ($tool)" >&2
        exit 126
        ;;
esac
resolved=$(PATH=$system realpath "$tool")
case "$resolved" in
    "$root"/*)
        echo "gate-exec: $name resolves inside the repository, refused: $resolved" >&2
        exit 126
        ;;
esac

exec "$tool" "$@"
