#!/usr/bin/env -S python3 -I
"""check-citations: resolve every `read from:` citation of the ESS documents under `ess/`
against the tree, so a citation whose text no longer says what it is cited for fails the check.

  check-citations [--repo <dir>] [check | dump | fix]

  check   every citation; exit 0 when each resolves and the needles tables have no unused or
          malformed row, else exit 1 naming each unresolved citation
          (`<document>:<line>: unresolved: <cited>`) with the lines it cites and where its
          needles are found
  dump    every citation with its key, its needles and its cited lines
  fix     check, and re-point each unresolved line citation whose needles occur once in the
          cited file: to the cited range shifted, when that resolves, else to the span the
          needles cover when it is no longer than the cited range; a citation whose needles
          resolve only over a longer span is left unresolved for a person. Only the cited text
          after `read from: ` is rewritten; the rest of its line and its ending stay
  --repo  the repository's root; the current directory without it

A citation is a full comment line of a `*.yaml` document under `ess/` holding `read from: `
and, after it, one of

  <path>:<a>[-<b>]          lines a to b of a file of this repository
  <path> (§ <heading>)      the section of that file under the heading whose text is <heading>
  <path>                    the file
  <tool> <version>, ...     a cross-repository citation; external, counted, not resolved

Every other `read from` (the words, in any case, on any line) fails and is named: one after `:`
in no form above, one in prose, an inline comment or a scalar, a capitalised one; and so does a
comment line whose text starts with `from:` and a path, a marker wrapped across two lines. These
are counted apart from the in-repository citations.

Every in-repository citation resolves by its needles, held in `<document>.citations.tsv` beside
the document, one row a citation: `<key><TAB><needle> && <needle> ...`. The needles occur in
order: for a line citation inside the cited range, the first on its first line when it is a
range, and the last occurrence of the last within one line of its last line; for a section
citation inside the one section whose heading text is the cited heading, from that heading to
the next heading of the same or a higher level (ATX or setext, outside fenced code and front
matter; a heading two sections share is unresolved); for a file citation anywhere in the file.
A citation without a row is unresolved, and so is a row no citation uses. The key is
`<declaration>|<following line>|<path>|<k>`: the top-level declaration the comment sits in (or
the one its block precedes), the stripped line the comment block precedes, the cited path, and
the citation's ordinal among those of that path before that line. A key does not hold a line
number, so re-pointing a citation keeps its row.

Python 3 standard library only; run with `python3 -I`.
"""

import argparse
import re
import sys
from collections import defaultdict
from pathlib import Path

MARKER = re.compile(r"\bread\s+from", re.IGNORECASE)
WRAPPED = re.compile(r"^\s*#\s*from:\s*\S*[/.]\S*", re.IGNORECASE)
CITATION = re.compile(r"^\s*#(?:.*\s)?read from: (.*)$")
DECLARATION = re.compile(r"^  - name: (\S+)")
PATH = r"[^\s:,()]+"
LINE = re.compile(r"^(" + PATH + r"):(\d+)(?:-(\d+))?$")
SECTION = re.compile(r"^(" + PATH + r") \(§ ([^)]+)\)$")
FILE = re.compile(r"^(" + PATH + r")$")
EXTERNAL = re.compile(r"^[A-Za-z][\w.-]* \d+\.\d+\.\d+\b[^,]*, \S")
HEADING = re.compile(r"^ {0,3}(#{1,6})(?:\s+(.*?))?\s*$")
SETEXT = re.compile(r"^ {0,3}(=+|-+)\s*$")
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
LIST_ITEM = re.compile(r"^\s*(?:[-*+]|\d+[.)])(?:\s|$)")
FORMS = "<path>:<a>[-<b>], <path> (§ <heading>), <path>, or <tool> <version>, <path>"


class Citation:
    def __init__(self, index, cited, kind, key=None, match=None, span=None):
        self.index = index
        self.cited = cited
        self.kind = kind
        self.key = key
        self.match = match
        self.span = span

    @property
    def path(self):
        return self.match.group(1)

    @property
    def lines(self):
        a = int(self.match.group(2))
        return a, int(self.match.group(3) or a)


def split_lines(text):
    """The lines of `text`, each with its ending, split on `\\n` only."""
    return re.findall(r"[^\n]*\n|[^\n]+$", text)


def body(line):
    line = line[:-1] if line.endswith("\n") else line
    return line[:-1] if line.endswith("\r") else line


class Unreadable(Exception):
    pass


def read_raw(path):
    """The lines of the file at `path` with their endings; None when there is no such file."""
    try:
        with open(path, encoding="utf-8", newline="") as f:
            return split_lines(f.read())
    except (FileNotFoundError, IsADirectoryError, NotADirectoryError):
        return None
    except UnicodeDecodeError as error:
        raise Unreadable(f"not UTF-8 ({error.reason} at byte {error.start})") from None


def citations(text):
    """Every `read from` of one document, in order, as a citation."""
    top = ""
    ordinal = defaultdict(int)
    for i, line in enumerate(text):
        m = DECLARATION.match(line)
        if m:
            top = m.group(1)
        hits = list(MARKER.finditer(line))
        if not hits:
            if WRAPPED.match(line):
                yield Citation(i, line.strip(), "stray")
            continue
        comment = line.lstrip().startswith("#")
        m = CITATION.match(line) if comment else None
        if m is None or len(hits) != 1:
            yield Citation(i, line.strip(), "stray")
            continue
        cited = m.group(1).strip()
        start = m.start(1) + len(m.group(1)) - len(m.group(1).lstrip())
        span = (start, start + len(cited))
        j = i
        while j < len(text) and text[j].lstrip().startswith("#"):
            j += 1
        following = text[j].strip() if j < len(text) else ""
        d = DECLARATION.match(text[j]) if j < len(text) else None
        context = d.group(1) if d else top
        if EXTERNAL.match(cited):
            yield Citation(i, cited, "external")
            continue
        for kind, form in (("line", LINE), ("section", SECTION), ("file", FILE)):
            f = form.match(cited)
            if f and in_repository(f.group(1)):
                base = f"{context}|{following}|{f.group(1)}"
                ordinal[base] += 1
                yield Citation(i, cited, kind, f"{base}|{ordinal[base]}", f, span)
                break
        else:
            yield Citation(i, cited, "unknown")


def in_repository(path):
    return not path.startswith("/") and ".." not in path.split("/")


def needles_table(path, name, problems):
    """The needles of each key in the table at `path`; empty when there is none."""
    table = {}
    try:
        raw = read_raw(path)
    except Unreadable as error:
        problems.append(f"{name}: {error}")
        return table
    for n, row in enumerate(raw or [], 1):
        row = body(row)
        if not row.strip() or row.startswith("#"):
            continue
        key, tab, needle = row.partition("\t")
        needles = [part.strip() for part in needle.split(" && ")]
        if not tab or not key or not all(needles):
            problems.append(f"{name}:{n}: malformed needle row")
        elif key in table:
            problems.append(f"{name}:{n}: a second row for {key}")
        else:
            table[key] = needles
    return table


def in_order(text, lo, hi, needles):
    """The line index of each needle found in order in text[lo:hi]; None when one is missing."""
    found = []
    at = lo
    for needle in needles:
        r = next((r for r in range(at, hi) if needle in text[r]), None)
        if r is None:
            return None
        found.append(r)
        at = r
    return found


def resolves(text, a, b, needles):
    if a < 1 or b > len(text) or a > b:
        return False
    found = in_order(text, a - 1, b, needles)
    if found is None:
        return False
    if a != b and found[0] != a - 1:
        return False
    last = max(r for r in range(found[-1], b) if needles[-1] in text[r])
    return last >= b - 2


def headings(text):
    """Every (line index, level, text) of a heading, ATX or setext, outside fences and the
    front matter."""
    found = []
    start = 0
    if text and text[0].strip() == "---":
        close = next((r for r in range(1, len(text)) if text[r].strip() in ("---", "...")), None)
        if close is not None:
            start = close + 1
    fence = None
    plain = None
    for r in range(start, len(text)):
        line = text[r]
        m = FENCE.match(line)
        if fence is not None:
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence):
                if not m.group(2).strip():
                    fence = None
            plain = None
            continue
        if m and not (m.group(1)[0] == "`" and "`" in m.group(2)):
            fence = m.group(1)
            plain = None
            continue
        m = HEADING.match(line)
        if m:
            found.append((r, len(m.group(1)), (m.group(2) or "").strip()))
            plain = None
            continue
        m = SETEXT.match(line)
        if m and plain is not None:
            found.append((plain, 1 if m.group(1)[0] == "=" else 2, text[plain].strip()))
            plain = None
            continue
        blank = not line.strip()
        plain = None if blank or LIST_ITEM.match(line) or line.startswith("    ") else r
    return found


def sections(text, heading):
    """Every (start, end) line index span of a section whose heading text is `heading`."""
    headings_found = headings(text)
    spans = []
    for k, (r, level, title) in enumerate(headings_found):
        if title != heading:
            continue
        end = next((s for s, lv, _ in headings_found[k + 1 :] if lv <= level), len(text))
        spans.append((r, end))
    return spans


def locate(text, needles):
    """Every (a, b) the needles span in order, the first needle on a."""
    spans = []
    for start, line in enumerate(text):
        if needles[0] in line:
            found = in_order(text, start, len(text), needles)
            if found is not None:
                spans.append((start + 1, found[-1] + 1))
    return spans


def span(a, b):
    return f"{a}" if a == b else f"{a}-{b}"


def show_lines(text, a, b):
    rows = list(range(a, b + 1))
    if len(rows) > 6:
        rows = rows[:3] + [None] + rows[-2:]
    for r in rows:
        if r is None:
            print("        ...")
        elif 1 <= r <= len(text):
            print(f"        {r}: {text[r - 1].strip()[:140]}")
        else:
            print(f"        {r}: <past the end, {len(text)} lines>")


def main():
    parser = argparse.ArgumentParser(
        prog="check-citations",
        description="Resolve every `read from:` citation of the ESS documents under ess/.",
    )
    parser.add_argument("--repo", default=".", help="the repository's root")
    parser.add_argument("mode", nargs="?", default="check", choices=("check", "dump", "fix"))
    args = parser.parse_args()
    repo = Path(args.repo)
    ess = repo / "ess"
    if not ess.is_dir():
        parser.error(f"no ess/ directory under {repo}")

    files = {}
    problems = []
    counts = defaultdict(int)
    unused_total = 0
    for document in sorted(ess.rglob("*.yaml")):
        name = document.relative_to(repo).as_posix()
        try:
            raw = read_raw(document) or []
        except Unreadable as error:
            problems.append(f"{name}: {error}")
            continue
        text = [body(line) for line in raw]
        table_path = document.with_name(document.stem + ".citations.tsv")
        table = needles_table(table_path, table_path.relative_to(repo).as_posix(), problems)
        seen = set()
        rewrite = {}
        for c in citations(text):
            if c.kind == "external":
                counts["external"] += 1
                if args.mode == "dump":
                    print(f"{name}:{c.index + 1}: external: {c.cited}")
                continue
            ok = False
            cited = None
            error = None
            needles = None
            if c.kind in ("line", "section", "file"):
                seen.add(c.key)
                needles = table.get(c.key)
                if c.path not in files:
                    try:
                        lines = read_raw(repo / c.path)
                        files[c.path] = (None if lines is None else [body(l) for l in lines], None)
                    except Unreadable as unreadable:
                        files[c.path] = (None, f"{unreadable}: {c.path}")
                cited, error = files[c.path]
                if cited is None and error is None:
                    error = f"no such file: {c.path}"
            if cited is not None and needles:
                if c.kind == "file":
                    ok = in_order(cited, 0, len(cited), needles) is not None
                elif c.kind == "section":
                    found = sections(cited, c.match.group(2))
                    ok = len(found) == 1 and in_order(cited, *found[0], needles) is not None
                else:
                    ok = resolves(cited, *c.lines, needles)
            if c.kind in ("stray", "unknown"):
                counts["not a citation"] += 1
            else:
                counts["resolved" if ok else "unresolved"] += 1
            if ok and args.mode != "dump":
                continue
            print(f"{name}:{c.index + 1}: {'ok' if ok else 'unresolved'}: {c.cited}")
            if c.kind == "stray":
                print("      `read from` outside a `# read from: <citation>` comment line")
                continue
            if c.kind == "unknown":
                print(f"      not a citation form: {FORMS}")
                continue
            print(f"      key: {c.key}")
            print(f"      needles: {' && '.join(needles) if needles else 'none'}")
            if error:
                print(f"      {error}")
                continue
            if c.kind == "section":
                found = sections(cited, c.match.group(2))
                heads = ", ".join(str(lo + 1) for lo, _ in found) or "none"
                print(f"      headings with that text at: {heads}")
                if len(found) > 1:
                    print(f"      the heading names {len(found)} sections; cite one by lines")
                continue
            if c.kind != "line":
                continue
            a, b = c.lines
            show_lines(cited, a, b)
            if ok or not needles:
                continue
            spans = locate(cited, needles)
            print(f"      needles found at: {', '.join(span(*s) for s in spans[:6]) or 'nowhere'}")
            if args.mode != "fix" or len(spans) != 1:
                continue
            shift = spans[0][0] - a
            na, nb = a + shift, b + shift
            if not resolves(cited, na, nb, needles):
                na, nb = spans[0]
                if nb - na > b - a:
                    print("      not re-pointed: the needles span more lines than the cited range")
                    continue
            new = f"{c.path}:{span(na, nb)}"
            line = raw[c.index]
            rewrite[c.index] = line[: c.span[0]] + new + line[c.span[1] :]
            print(f"      re-pointed: {new}")
        for key in sorted(set(table) - seen):
            print(f"{table_path.relative_to(repo).as_posix()}: unused needle: {key}")
            unused_total += 1
        if rewrite:
            for i, line in rewrite.items():
                raw[i] = line
            with open(document, "w", encoding="utf-8", newline="") as f:
                f.write("".join(raw))
            print(f"{name}: rewrote {len(rewrite)} citation lines")
    for problem in problems:
        print(problem)
    in_repo = counts["resolved"] + counts["unresolved"]
    print(
        f"citations: {in_repo} in-repository, {counts['resolved']} resolved, "
        f"{counts['unresolved']} unresolved; {counts['external']} external, not resolved here; "
        f"{unused_total} unused needles; {counts['not a citation']} `read from` lines in no "
        f"citation form"
    )
    failed = counts["unresolved"] or counts["not a citation"] or unused_total or problems
    sys.exit(1 if failed else 0)


main()
