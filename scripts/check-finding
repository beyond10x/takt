#!/usr/bin/env bash
# check-finding: run a filed finding's `expected_before` predicate on its scenario with a takt
# built from a given revision, and print whether the defect is there.
#
#   check-finding [--scenarios <repo>] [--declared-on <rev>] [--checkout <url>=<path>]...
#                 [--repo <dir>] <finding> <revision>
#
#   <finding>        the finding's artifact id in this repository's planning store, as
#                    `scripts/file-finding` filed it (`story:<key>` or `blocker:<key>`)
#   <revision>       the takt revision to build, resolved in this repository; the promoted
#                    revision for the baseline, the candidate's for a fix
#   --scenarios      a checkout of the scenario repository, required for a predicate that names
#                    a `scenario`; it is only read: the predicate runs in a clone of it. A
#                    predicate that names its `repository` ignores it
#   --declared-on    the revision of the scenario repository whose `.engineering/scenarios.conf`
#                    declares the scenario (`[scenario "<id>"]`, `story` and `seed`); `main`
#   --checkout       for a predicate that names its `repository`: a local checkout that stands in
#                    for that `https://` URL, cloned instead of it (speed, or no network);
#                    repeatable, one URL each. The predicate itself never names a path: it is
#                    committed to a public repository and must hold on every machine
#   --repo           this repository; the top of the tree the script is run in
#
# Steps: the finding's file is read from the store (`.engineering/planning/<kind>/<name>.md`,
# read only, so the check needs no `aep`) and its predicate parsed by
# `scripts/file-finding --predicate`. A predicate names a `scenario`, whose declaration is read
# from `--declared-on` with `git config --no-includes --blob`, as `takt scenario run` reads it;
# or a `repository` (an `https://` URL) with the `seed` the task starts from and, optionally,
# the task's `test` command. The revision is checked out into a build directory
# of its own under the cache (a repository made with no template that fetches the revision by
# its id from this one through git's transport, every object hashed and checked as it is
# received, so a commit no branch holds builds too and an object overwritten in this repository's
# store is refused, naming it) and built with `cargo build --locked --offline`,
# confined in bubblewrap (`bwrap`, on PATH) as `takt promote` builds a candidate
# (crates/takt/src/promotion.rs): the environment cleared but for HOME, TMPDIR, PATH, LANG,
# TERM when set, CARGO_HOME and RUSTC; an empty HOME and /tmp of its own; its own process and
# network namespaces; the system directories and the toolchain read-only, the toolchain
# rustup's default (`default_toolchain` in `$RUSTUP_HOME/settings.toml`, `~/.rustup` without
# it), its own `cargo` and `rustc` called, never a proxy on PATH; a scratch CARGO_HOME with the
# caller's registry and git caches (`$CARGO_HOME`, `~/.cargo` without it) read-only under it;
# and the checkout, the target directory and that CARGO_HOME, all three inside the build
# directory, the only paths it can write. So a revision's `build.rs`, proc macros and
# `.cargo/config.toml` read nothing of the caller's environment or home and write nothing
# outside the build directory, another revision's kept binary among it; without bubblewrap the
# check builds nothing. The target is the host's (`--config build.target=<host>`, over the
# revision's configuration), and the binary kept is the one cargo reports building (the
# `executable` of its JSON message for the `takt` bin), never a file the revision commits where
# a build would put it. The binary is kept per revision beside a
# `revision` file naming the commit it was built from, and the build directory removed. A build
# is made in a checkout, never from an export, so the binary's `--version` and its runs' `opened`
# records name the revision; a kept binary with no `revision` file beside it predates that and is
# built again. The scenario repository, or the predicate's repository (the checkout `--checkout`
# gives for its URL, else the URL itself), is cloned by a git that runs as the predicate will,
# not as the caller: its environment replaced (`env -i`) by PATH, LANG and the fresh HOME below,
# so no `GIT_CONFIG_*`, `GIT_CONFIG_PARAMETERS`, `GIT_DIR`, `GIT_ASKPASS`, `GIT_SSH_COMMAND` or
# agent socket of the caller reaches it, with no system or global configuration, no credential
# helper, no ssh command, no askpass and no prompt (`GIT_TERMINAL_PROMPT=0`: a repository that
# wants a credential fails, it does not ask), without hardlinks, and dissociated from any
# repository its source borrows objects from. The clone's `trial/0` is set to the seed (whatever
# branch the checkout was on) and checked out and its remote removed, by that same git; then the
# predicate's command runs there through `sh -c`, with `$TAKT` the binary, `$SCENARIO` the clone
# and, when the predicate gives one, `$TEST` the task's test command. Its environment holds only
# PATH, LANG, TAKT, SCENARIO, TEST and HOME, and HOME is a fresh directory of the check's own,
# never the caller's, so no credential of the caller reaches it, neither from the environment
# nor from a file a tool reads under HOME (git's credential store, a CLI's login). The command
# runs under bubblewrap with every host path read-only but the clone and the predicate's home:
# the repository, the kept `builds/<sha>/takt`, the caller's protocol sources by their real
# paths and the run directory, where the check keeps the predicate, the command's output and
# the result, cannot be written. The caller's home, the directory HOME names, and the home of
# the user the check runs as, its passwd entry's, are empty read-only directories there, so
# nothing under them is read or written but what the check binds into them (a repository under
# one is not there at all); devices, /proc, /tmp and /run are its own, so no socket of the
# user's session, its agents or the container engines is in sight. The caller's cache of the
# public protocol sources `aep` reads is bound read-only at the home's
# `.cache/aep/protocol-sources`, so `aep` needs no network there. The command runs in network,
# IPC and PID namespaces of its own: no network and no abstract unix socket of the host, and
# every process it leaves is killed when it ends; bubblewrap's status reaches the script on a
# pipe, so no process of an earlier check reaches this one's result. It keeps the caller's
# user, and a socket the host holds outside the paths above stays in sight where the user may
# open it; without bubblewrap no predicate runs. Neither bubblewrap, the build's nor the
# command's, inherits a descriptor above 2 the caller left open: each is closed first, so no
# file the caller holds open reaches the revision's code through `/proc/self/fd`. The
# script's own git reads and writes name their repository by path, so a `GIT_DIR`,
# `GIT_WORK_TREE` or `GIT_INDEX_FILE` of the caller (a hook's environment) is unset before any
# of them.
# The cache is `$XDG_CACHE_HOME/takt/check-finding`, `~/.cache/takt/check-finding` without it:
# `builds/<sha>/takt` and `builds/<sha>/revision`, and one directory per check under `runs/`
# holding the finding, the clone, the predicate's home, the command's output and the result,
# kept as the record of the check.
# One check builds and runs at a time per cache directory, whichever session starts it: the
# build and the predicate's run are made under an advisory lock (`flock`) on `lock` in that
# directory, and a check that finds it held says it is waiting, naming it, and waits. The lock
# is the open descriptor's, released when the check ends however it ends (a killed check leaves
# none that blocks), and no build or command the check starts inherits it. Before the lock is
# waited for, and again once it is taken, the check reads the free space of the file system
# holding the cache directory (`df`) and refuses, before anything is built, when it is under
# CHECK_FINDING_MIN_FREE_GIB GiB, 20 by default (0 checks nothing), naming the directory, its
# free space and the threshold. The variable is there for tests, which need no full disk.
#
# Standard output is one line, the result of the `scenario_result` evidence kind
# (protocols/self-improvement/1.yaml): `reproduced` when every expectation the predicate gives
# held (the exit status, the fixed string in standard output or standard error) and the command
# ended with a status the predicate names (its `exit`, else its `healthy_exit`); else
# `not_reproduced` when the command ended with the predicate's `healthy_exit` (0 when it names
# none), the one status that says the command ran to the scenario and the defect is gone; else
# `error`, the status named on standard error and in the record: a crash, a command that never
# started, a flag rejected, or any status the predicate does not name as the healthy one. An
# `error` verifies nothing. All three exit 0. A check that cannot run its predicate (no such
# finding, a predicate that does not parse, a revision that names no commit, a scenario not
# declared, no bubblewrap or no toolchain for a build, a build that fails, a HOME that names
# no directory to hide, a bubblewrap that did not run the command to its end, its error named
# on standard error, its status pipe's last line not the exit it gave, a command past
# CHECK_FINDING_TIMEOUT seconds, 900 by default, a file system under the free-space threshold,
# a lock that cannot be taken) prints nothing on standard output and exits 1; a usage error, a
# CHECK_FINDING_TIMEOUT that is no whole number of seconds or a CHECK_FINDING_MIN_FREE_GIB that
# is no whole number of GiB among them, exits 64.
#
# On macOS (`uname -s` is Darwin) Seatbelt stands where bubblewrap does: `sandbox-exec`, on
# PATH, applies a profile the script writes, every path in it a parameter (`-D`), and without it
# nothing is built and no predicate runs. Each path is given by its real path, as Seatbelt
# matches it (`/tmp` is `/private/tmp`). The build runs at its host paths in the build
# directory, its environment as above but for HOME and TMPDIR, directories of the build's own
# there; with no network; writing only to the checkout, the target directory, the scratch
# CARGO_HOME (the caller's caches linked into it, read through the links and never written),
# that home and temporary directory, and this user's temporary and cache directories (`getconf`
# DARWIN_USER_TEMP_DIR and DARWIN_USER_CACHE_DIR), which the compiler and the linker use; and
# under the hidden homes below reading only those, the toolchain and the caches. The predicate's
# command runs with no network (no TCP and no unix socket); writing only to the clone, its home
# and this user's temporary and cache directories; with the hidden homes, `/tmp` and `/var/run`
# unreadable but for the clone, its home, the kept binary and the caller's protocol sources,
# which `.cache/aep/protocol-sources` of its home links to by their real path and which it
# cannot write through the link. The build and the command each run in a session and process
# group of their own (`perl`'s `POSIX::setsid`), killed whole when they end; that `perl` keeps
# CHECK_FINDING_TIMEOUT. An `sh` inside the profile runs the command with the status pipe
# closed and writes `{ "exit-code": N }` on it after the command ended, the line read as
# bubblewrap's is. What Seatbelt does not give: a process that leaves the command's process
# group outlives the check; the host's System V and POSIX IPC and its Mach services stay in
# reach; the command has no `/tmp` of its own; and a refused write fails with "Operation not
# permitted", not "Read-only file system".
set -euo pipefail

# The repositories this script reads and writes are the ones it names by path, as they hold
# them; a GIT_DIR, GIT_WORK_TREE or GIT_INDEX_FILE of the caller (a hook's environment) would send
# every `git -C` to another repository, or a checkout into the caller's index, and a
# GIT_OBJECT_DIRECTORY, GIT_ALTERNATE_OBJECT_DIRECTORIES or GIT_COMMON_DIR (a hook's environment
# under quarantine), a GIT_CONFIG_PARAMETERS or GIT_CONFIG_COUNT, a GIT_GRAFT_FILE,
# GIT_SHALLOW_FILE, GIT_REPLACE_REF_BASE, GIT_NAMESPACE or GIT_TEMPLATE_DIR would lend it objects,
# configuration or history it does not hold. None reaches a git here; the build's git runs under
# a cleared environment besides (`build_git`).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
    GIT_COMMON_DIR GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_GRAFT_FILE GIT_SHALLOW_FILE \
    GIT_REPLACE_REF_BASE GIT_NAMESPACE GIT_TEMPLATE_DIR
# Nor does a replace ref of a repository it reads (`refs/replace/`, which a scenario checkout
# can hold): every git here reads the objects the ids name, as takt's own git does.
export GIT_NO_REPLACE_OBJECTS=1

say() { printf 'check-finding: %s\n' "$*" >&2; }
usage() {
    say "$*"
    say "usage: check-finding [--scenarios <repo>] [--declared-on <rev>] [--checkout <url>=<path>]... [--repo <dir>] <finding> <revision>"
    exit 64
}
fail() {
    say "$*; no result"
    exit 1
}
# Closes every descriptor above 2 of the shell it runs in, to be called in the subshell that
# then starts bubblewrap: a descriptor the caller left open passes to every process bubblewrap
# runs, and through `/proc/self/fd/N` or `/dev/fd/N` it reads the file it names, whatever the
# sandbox hides of that file's path. The descriptors are listed from `/proc/self/fd`, or from
# `/dev/fd` where there is no `/proc` (macOS), which lists the shell's own there.
close_inherited() {
    local fd dir=/proc/self/fd
    [[ -d $dir ]] || dir=/dev/fd
    for fd in "$dir"/*; do
        fd=${fd##*/}
        [[ $fd =~ ^[0-9]+$ ]] && ((fd > 2)) || continue
        { eval "exec $fd<&-"; } 2>/dev/null || true
    done
}

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
scenarios= declared_on=main repo=
# The `--checkout` options: checkout_urls[i] stands in for checkout_paths[i]. Two indexed arrays,
# not one associative array, which macOS's bash 3.2 does not have.
checkout_urls=()
checkout_paths=()
# Prints the checkout `--checkout` gives for the URL $1, with no newline; status 1 when it gives
# none.
checkout_for() {
    local i
    for ((i = 0; i < ${#checkout_urls[@]}; i++)); do
        if [[ ${checkout_urls[i]} == "$1" ]]; then
            printf '%s' "${checkout_paths[i]}"
            return 0
        fi
    done
    return 1
}
positional=()
while (($#)); do
    case $1 in
    --scenarios | --declared-on | --repo | --checkout)
        (($# >= 2)) || usage "$1 takes a value"
        case $1 in
        --scenarios) scenarios=$2 ;;
        --declared-on) declared_on=$2 ;;
        --repo) repo=$2 ;;
        --checkout)
            [[ $2 == https://?*=?* ]] || usage "--checkout $2: give <https-url>=<path>, the URL a predicate names and the local checkout that stands in for it"
            url=${2%%=*}
            path=${2#*=}
            if checkout_for "$url" >/dev/null; then
                usage "--checkout $2: $url is given twice"
            fi
            stands_in=$(cd "$path" 2>/dev/null && pwd -P) || usage "--checkout $2: $path is no directory"
            checkout_urls+=("$url")
            checkout_paths+=("$stands_in")
            ;;
        esac
        shift 2
        ;;
    -h | --help)
        sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"
        exit 0
        ;;
    --) shift; positional+=("$@"); break ;;
    -*) usage "unexpected option \`$1\`" ;;
    *) positional+=("$1"); shift ;;
    esac
done
((${#positional[@]} == 2)) || usage "give the finding and the revision"
finding=${positional[0]}
revision=${positional[1]}
if [[ -n $scenarios ]]; then
    scenarios=$(cd "$scenarios" 2>/dev/null && pwd -P) || usage "--scenarios: no directory"
fi
if [[ -z $repo ]]; then
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || usage "not inside a repository; give --repo"
fi
repo=$(cd "$repo" 2>/dev/null && pwd -P) || usage "--repo: no directory"
# Checked before anything runs: `timeout` given no duration it takes exits 125 without running
# the command, which would be read as the predicate's exit.
limit=${CHECK_FINDING_TIMEOUT:-900}
[[ $limit =~ ^[1-9][0-9]{0,5}$ ]] ||
    usage "CHECK_FINDING_TIMEOUT=$limit: give a whole number of seconds, 1 to 999999"
min_free=${CHECK_FINDING_MIN_FREE_GIB-20}
[[ $min_free =~ ^(0|[1-9][0-9]{0,5})$ ]] ||
    usage "CHECK_FINDING_MIN_FREE_GIB=$min_free: give a whole number of GiB, 0 to 999999"
[[ $finding =~ ^([a-z][a-z-]*):([a-z0-9]+(-[a-z0-9]+)*)$ ]] ||
    usage "$finding: a finding is an artifact id, \`<kind>:<name>\`"
finding_file=$repo/.engineering/planning/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}.md

cache=${XDG_CACHE_HOME:-}
[[ $cache == /* ]] || cache=$HOME/.cache
root=$cache/takt/check-finding
mkdir -p "$root/runs" "$root/builds"
run=$(mktemp -d "$root/runs/${finding//[^A-Za-z0-9-]/-}-XXXXXX")
say "record: $run"

# The finding and its predicate, from the store's file, read only.
cd "$repo"
[[ -f $finding_file ]] || fail "the store in $repo holds no $finding"
cp -- "$finding_file" "$run/finding.md"
"$here/file-finding" --predicate "$run/finding.md" >"$run/predicate.tsv" 2>"$run/predicate.err" ||
    fail "$finding: its predicate does not parse: $(tail -n 1 "$run/predicate.err")"
# The predicate's entries: predicate_keys[i] gives predicate_values[i], a later line for a key
# replacing an earlier one. Two indexed arrays, not one associative array, which macOS's bash 3.2
# does not have.
predicate_keys=()
predicate_values=()
while IFS=$'\t' read -r key value; do
    [[ -n $key ]] || fail "$finding: $run/predicate.tsv holds a line with no key"
    i=0
    while ((i < ${#predicate_keys[@]})) && [[ ${predicate_keys[i]} != "$key" ]]; do
        i=$((i + 1))
    done
    predicate_keys[i]=$key
    predicate_values[i]=$value
done <"$run/predicate.tsv"
# Prints the value the predicate gives the key $1, with no newline; status 1 when it gives none.
predicate_value() {
    local i
    for ((i = 0; i < ${#predicate_keys[@]}; i++)); do
        if [[ ${predicate_keys[i]} == "$1" ]]; then
            printf '%s' "${predicate_values[i]}"
            return 0
        fi
    done
    return 1
}
scenario=$(predicate_value scenario) || scenario=
repository=$(predicate_value repository) || repository=
test_command=$(predicate_value test) || test_command=
command=$(predicate_value command) || fail "$finding: its predicate gives no command"

# The revision, in this repository.
sha=$(git -C "$repo" rev-parse --verify --quiet "$revision^{commit}") ||
    fail "$revision names no commit in $repo"

# What the predicate runs on: a scenario, as the scenario repository declares it, or the
# repository and seed the predicate names.
story= seed= source=
if [[ -n $scenario ]]; then
    [[ -n $scenarios ]] || usage "--scenarios is required: the predicate names scenario $scenario, which the scenario repository's checkout declares"
    source=$scenarios
    conf=.engineering/scenarios.conf
    git -C "$scenarios" cat-file -e "$declared_on:$conf" 2>/dev/null ||
        fail "$declared_on holds no $conf in $scenarios; the scenarios are declared there"
    # Without includes, as takt reads it (crates/takt/src/git.rs:204): a scenario declared only
    # through an include is none to `takt scenario run`, and an include is never opened. The
    # section `scenario.<id>.` is held to takt's rules (crates/takt-cli/src/main.rs:714-753):
    # `story` and `seed` once each, with a value, and no other key.
    git -C "$scenarios" config --no-includes --blob "$declared_on:$conf" --list -z \
        >"$run/scenarios.list" 2>"$run/scenarios.err" ||
        fail "scenario $scenario: $conf at $declared_on does not read: $(head -n 1 "$run/scenarios.err")"
    declared=
    while IFS= read -r -d '' entry; do
        key=${entry%%$'\n'*}
        [[ $key == "scenario.$scenario."* ]] || continue
        declared=1
        name=${key#"scenario.$scenario."}
        case $name in
        story | seed) ;;
        *) fail "scenario $scenario: $conf at $declared_on gives \`$name\`, which takt does not read; a scenario gives \`story\` and \`seed\`" ;;
        esac
        value=
        [[ $entry == *$'\n'* ]] && value=${entry#*$'\n'}
        value=${value#"${value%%[![:space:]]*}"}
        value=${value%"${value##*[![:space:]]}"}
        [[ -n $value ]] || fail "scenario $scenario: $conf at $declared_on gives \`$name\` no value"
        [[ -z ${!name} ]] || fail "scenario $scenario: $conf at $declared_on gives \`$name\` twice"
        printf -v "$name" '%s' "$value"
    done <"$run/scenarios.list"
    [[ -n $declared ]] || fail "scenario $scenario: $conf at $declared_on declares no scenario $scenario"
    [[ -n $story ]] || fail "scenario $scenario: $conf at $declared_on gives no \`story\`"
    [[ -n $seed ]] || fail "scenario $scenario: $conf at $declared_on gives no \`seed\`"
    seed=$(git -C "$scenarios" rev-parse --verify --quiet "$seed^{commit}") ||
        fail "scenario $scenario: its seed $seed is no commit in $scenarios"
    where="scenario $scenario ($story at ${seed:0:12})"
else
    [[ -z $scenarios ]] || say "--scenarios is not read: the predicate names its repository, $repository"
    source=$repository
    checkout=
    if checkout=$(checkout_for "$repository"); then
        source=$checkout
        say "$repository: cloning the checkout $checkout in its place"
    fi
    seed=$(predicate_value seed) || fail "$finding: its predicate names repository $repository and no seed"
    where="$repository at ${seed:0:12}"
fi
# A --checkout for a URL the predicate does not name stands in for nothing: a mistyped URL
# would otherwise send the check to the network without a word.
for ((i = 0; i < ${#checkout_urls[@]}; i++)); do
    url=${checkout_urls[i]}
    [[ $url == "$repository" ]] ||
        usage "--checkout $url=${checkout_paths[i]}: the predicate names ${repository:-no repository}, not $url"
done

# The toolchain a build calls, as `takt promote` resolves it (crates/takt/src/promotion.rs,
# `Confinement::toolchain`): rustup's home (RUSTUP_HOME, else ~/.rustup), the
# `default_toolchain` its settings.toml names, and that toolchain's directory under
# `toolchains/`, by its name or the one directory named by it and a target triple; its
# `bin/cargo` and `bin/rustc` executable and its `lib/rustlib` there. Never one PATH, a
# `rust-toolchain.toml` of the revision or RUSTUP_TOOLCHAIN picks. Prints the directory, or
# says what is missing and fails.
toolchain_dir() {
    local rustup_home=${RUSTUP_HOME:-} settings name line dir found=()
    [[ $rustup_home == /* ]] || rustup_home=$HOME/.rustup
    settings=$rustup_home/settings.toml
    [[ -r $settings ]] ||
        fail "read $settings, rustup's settings, which name the toolchain the build calls; the build finds no toolchain on PATH"
    name=
    while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*default_toolchain[[:space:]]*=[[:space:]]*\"?([^\"[:space:]]*)\"?[[:space:]]*$ ]] || continue
        name=${BASH_REMATCH[1]}
        [[ -n $name ]] && break
    done <"$settings"
    [[ -n $name ]] || fail "$settings names no default_toolchain; the build calls rustup's default toolchain and finds none on PATH"
    [[ $name != */* && $name != .* ]] || fail "$settings: default_toolchain $name is no toolchain name"
    if [[ -d $rustup_home/toolchains/$name ]]; then
        dir=$rustup_home/toolchains/$name
    else
        for dir in "$rustup_home/toolchains/$name"-*; do
            [[ -d $dir ]] && found+=("$dir")
        done
        ((${#found[@]} == 1)) ||
            fail "rustup's default toolchain $name ($settings) matches ${#found[@]} directories under $rustup_home/toolchains, not one"
        dir=${found[0]}
    fi
    [[ -x $dir/bin/cargo && -x $dir/bin/rustc && -d $dir/lib/rustlib ]] ||
        fail "the toolchain $dir (rustup's default, $settings) has no executable bin/cargo and bin/rustc, or no lib/rustlib"
    printf '%s\n' "$dir"
}

# takt, built from the revision in a checkout of its own, once per revision, confined in
# bubblewrap. The checkout is a repository of its own, made with no template (one could lend it
# this repository's objects through `objects/info/alternates`, so the fetch would receive none),
# that fetches the revision, by its id, from this one through git's transport, never a local
# copy of the object files: every object is
# hashed as it is received and checked (`transfer.fsckObjects`), so one overwritten in this
# repository's store fails the build, git naming it, rather than building other content. It
# holds its own copy of the objects (no hardlink and no alternate into this repository, which the
# build cannot see), so a revision no branch holds still builds and the build's git reads the
# checkout alone; and it is a checkout rather than an export, so the build script reads the
# revision into the binary. A kept binary without the `revision` file beside it was built from an
# export, and is replaced.
# Never unconfined: without bubblewrap nothing is built and no predicate runs; on macOS, without
# sandbox-exec.
darwin=
[[ $(uname -s) != Darwin ]] || darwin=1
if [[ -n $darwin ]]; then
    confiner=$(command -v sandbox-exec) ||
        fail "sandbox-exec (Seatbelt) is not on PATH; on macOS check-finding builds the revision confined in it and runs the predicate under it, never without"
    [[ -x /usr/bin/perl ]] ||
        fail "/usr/bin/perl is not there; on macOS check-finding runs the build and the predicate in a process group of their own under it, killed when they end, never without"
else
    bwrap=$(command -v bwrap) ||
        fail "bubblewrap (\`bwrap\`) is not on PATH; check-finding builds the revision confined in it and runs the predicate under it, never without, so install bubblewrap first"
fi

# The homes hidden from the build (macOS) and the command. The caller's home: the directory HOME
# names, by its real path. A HOME that names no directory, or names the root, is no home to
# hide, and nothing runs. And the home of the user the check runs as, its passwd entry's,
# whatever HOME names: under a HOME of another directory it would be in sight (`~/.ssh`, a git
# configuration). One home that holds the other is hidden alone; a user with no passwd entry, or
# whose passwd home is no directory or the root, has none to hide. Where there is no `getent`
# (macOS) the entry is read from the directory service, `dscl`.
hidden=() hidden_found=
hide_homes() {
    [[ -z $hidden_found ]] || return 0
    hidden_found=1
    callers_home=$(cd "${HOME:-}" 2>/dev/null && pwd -P) && [[ -n ${HOME:-} && $callers_home != / ]] ||
        fail "HOME=${HOME:-} names no directory other than the root; the command runs with the caller's home hidden, never without"
    hidden=("$callers_home")
    if command -v getent >/dev/null; then
        user_home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6) || user_home=
    else
        user_home=$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null |
            sed -n 's/^NFSHomeDirectory: //p') || user_home=
    fi
    if [[ -n $user_home ]] && user_home=$(cd "$user_home" 2>/dev/null && pwd -P) && [[ $user_home != / ]]; then
        if [[ $callers_home/ == "$user_home"/* ]]; then
            hidden=("$user_home")
        elif [[ $user_home/ != "$callers_home"/* ]]; then
            hidden+=("$user_home")
        fi
    fi
}

if [[ -n $darwin ]]; then
    # The real path of the existing path $1, as Seatbelt matches it.
    real_path() {
        if [[ -d $1 ]]; then
            (cd "$1" && pwd -P)
        else
            printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd -P)" "$(basename "$1")"
        fi
    }
    # The profile being written: its text, one rule a line, a later rule over an earlier one for
    # what both match, and the `-D P<n>=<path>` arguments its rules read (sb_count of them).
    sb_reset() {
        sb_text='(version 1)
(allow default)'
        sb_args=()
        sb_count=0
    }
    sb_rule() { sb_text+=$'\n'"$1"; }
    # One rule that $1s (`allow`, `deny`) the operation $2 on each path after the filter $3
    # (`subpath`, `literal`); none for no path, as a rule with no filter matches everything.
    sb_paths() {
        local action=$1 operation=$2 filter=$3 rule path
        shift 3
        (($#)) || return 0
        rule="($action $operation"
        for path; do
            sb_args+=(-D "P$sb_count=$path")
            rule+=" ($filter (param \"P$sb_count\"))"
            sb_count=$((sb_count + 1))
        done
        sb_rule "$rule)"
    }
    # Allows looking up (`file-read-metadata`) each directory above the paths given that lies
    # under a directory whose reads are denied (`sb_denied`), that directory included, so a path
    # allowed under it is reached.
    sb_ancestors() {
        local path dir home known seen found=()
        for path; do
            dir=$path
            while [[ $dir == /*/* ]]; do
                dir=${dir%/*}
                for home in "${sb_denied[@]}"; do
                    [[ $dir == "$home" || $dir == "$home"/* ]] || continue
                    seen=
                    for known in ${found[@]+"${found[@]}"}; do
                        [[ $known != "$dir" ]] || seen=1
                    done
                    [[ -n $seen ]] || found+=("$dir")
                    break
                done
            done
        done
        sb_paths allow file-read-metadata literal ${found[@]+"${found[@]}"}
    }
    # The devices every confined process writes to.
    sb_devices='(allow file-write* (literal "/dev/null") (literal "/dev/zero") (literal "/dev/dtracehelper") (regex #"^/dev/tty") (regex #"^/dev/fd/"))'
    # This user's temporary and cache directories, which the compiler, the linker and the
    # system's tools write whatever TMPDIR says.
    darwin_dirs=()
    for name in DARWIN_USER_TEMP_DIR DARWIN_USER_CACHE_DIR; do
        dir=$(getconf "$name" 2>/dev/null) || continue
        [[ -n $dir && -d $dir ]] || continue
        darwin_dirs+=("$(real_path "$dir")")
    done
    # Runs the program after the limit ($1, seconds; 0 for none) in a session and process group
    # of its own and kills that whole group when the program ends, or when the limit passes,
    # then exits 124; else with the program's status (128 + N for signal N).
    reaper='use strict; use POSIX ();
my $limit = shift @ARGV;
my $pid = fork;
defined $pid or die "check-finding: fork: $!\n";
if ($pid == 0) {
    POSIX::setsid() or POSIX::_exit(126);
    exec { $ARGV[0] } @ARGV;
    print STDERR "check-finding: run $ARGV[0]: $!\n";
    POSIX::_exit(127);
}
my $late = 0;
$SIG{ALRM} = sub { $late = 1; kill 9, -$pid; kill 9, $pid; };
alarm $limit;
my $status = -1;
while ($status < 0) {
    my $ended = waitpid $pid, 0;
    if ($ended == $pid) { $status = $?; }
    elsif ($ended == -1 && !$!{EINTR}) { $status = 255 << 8; }
}
alarm 0;
kill 9, -$pid;
for (1 .. 400) { last unless kill 0, -$pid; select undef, undef, undef, 0.005; }
exit 124 if $late;
exit(($status & 127) ? 128 + ($status & 127) : $status >> 8);'
    hide_homes
    sb_homes=()
    for dir in "${hidden[@]}"; do
        sb_homes+=("$(real_path "$dir")")
    done
fi

# One check at a time per cache directory, and none on a file system short of space. Builds of
# several checks in flight add up (each a full takt build in a directory of its own); the lock
# makes them one after the other, whichever session starts them. The lock is held on the open
# descriptor until the script ends, so a check killed while it holds the lock leaves none that
# blocks; `close_inherited` closes it before bubblewrap starts, so a build or a command left
# running does not hold it either. The free space is read before the lock is waited for and
# again once it is taken after a wait, since another check's build may have used it meanwhile.
enough_space() {
    ((min_free > 0)) || return 0
    local avail
    avail=$(df -Pk -- "$root" 2>/dev/null | awk 'NR == 2 { print $4 }') && [[ $avail =~ ^[0-9]+$ ]] ||
        fail "df names no free space for the file system of $root; nothing is built where the free space cannot be read"
    ((avail >= min_free * 1048576)) ||
        fail "the file system of $root has $((avail / 1048576)).$((avail % 1048576 * 10 / 1048576)) GiB free ($avail KiB), under the threshold of $min_free GiB (CHECK_FINDING_MIN_FREE_GIB); nothing is built"
}
enough_space
command -v flock >/dev/null ||
    fail "flock is not on PATH; check-finding builds and runs one check at a time under it, never without"
lock=$root/lock
lock_fd=9
exec 9>>"$lock" || fail "open the lock $lock"
if ! flock --nonblock "$lock_fd"; then
    say "waiting for $lock: another check-finding builds or runs under it"
    flock "$lock_fd" || fail "take the lock $lock"
    say "took $lock"
    enough_space
fi

takt=$root/builds/$sha/takt
if [[ ! -x $takt || ! -f $root/builds/$sha/revision ]]; then
    # Without the toolchain nothing is built.
    toolchain=$(toolchain_dir) || exit 1
    cached=${CARGO_HOME:-}
    [[ $cached == /* ]] || cached=$HOME/.cargo
    work=$(mktemp -d "$root/builds/$sha.work-XXXXXX")
    trap 'rm -rf -- "$work"' EXIT
    mkdir -p "$work/target" "$work/cargo-home" "$work/git-home"
    # The build's checkout is made, fetched and checked out by a git that runs as the predicate's
    # clone does (`clone_git`): with the environment replaced (`env -i`), so no
    # GIT_OBJECT_DIRECTORY, GIT_ALTERNATE_OBJECT_DIRECTORIES, GIT_COMMON_DIR, GIT_CONFIG_PARAMETERS,
    # GIT_CONFIG_COUNT or GIT_GRAFT_FILE of the caller (a hook's environment under quarantine
    # carries some) lends it objects or changes what it reads, in a home of its own, with no
    # system or global configuration and no prompt.
    build_git() {
        env -i PATH="$PATH" HOME="$work/git-home" LANG="${LANG:-C.UTF-8}" \
            GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 git "$@"
    }
    { build_git init --quiet --template= -- "$work/src" &&
        build_git -C "$work/src" -c transfer.fsckObjects=true fetch --quiet --no-tags -- "$repo" "$sha"; } >&2 ||
        fail "fetch $sha from $repo for the build, every object hashed and checked"
    build_git -C "$work/src" checkout --quiet --detach "$sha" >&2 ||
        fail "check out $sha from $repo"
    # The target is the host's whatever the revision's `.cargo/config.toml` says (`--config` on
    # the command line wins over every configuration file; the environment, CARGO_BUILD_TARGET
    # among it, is cleared), and the binary kept is the one cargo reports building: the
    # `executable` of the `compiler-artifact` message for the `takt` bin of b10x-takt-cli,
    # under the target directory as the build sees it (`inside`), never a file the revision
    # commits where a build would put it.
    host=$(env -i "$toolchain/bin/rustc" -vV 2>/dev/null | sed -n 's/^host: //p') && [[ -n $host ]] ||
        fail "$toolchain/bin/rustc -vV names no host"
    [[ $host =~ ^[A-Za-z0-9_.-]+$ ]] || fail "$toolchain/bin/rustc names the host \`$host\`, no target triple"
    if [[ -n $darwin ]]; then
        # The profile of `takt promote`'s build on macOS (crates/takt/src/seatbelt.rs, `build`):
        # no network; writes only to the devices, the checkout, the target directory, the
        # scratch CARGO_HOME, the build's home and temporary directory and this user's temporary
        # and cache directories; under the hidden homes reads only those, the toolchain and the
        # caller's caches, linked into the scratch CARGO_HOME, and looks up the directories above
        # them. The build sees every path at its host path.
        rwork=$(real_path "$work")
        mkdir -p "$rwork/build-home" "$rwork/tmp"
        readable=("$(real_path "$toolchain")")
        for dir in registry/cache registry/index git/db git/checkouts; do
            if [[ -d $cached/$dir ]]; then
                mkdir -p "$(dirname "$rwork/cargo-home/$dir")"
                ln -s "$(real_path "$cached/$dir")" "$rwork/cargo-home/$dir"
                readable+=("$(real_path "$cached/$dir")")
            fi
        done
        writable=("$rwork/src" "$rwork/target" "$rwork/cargo-home" "$rwork/build-home" "$rwork/tmp"
            ${darwin_dirs[@]+"${darwin_dirs[@]}"})
        sb_reset
        sb_rule '(deny network*)'
        sb_rule '(deny file-write*)'
        sb_rule "$sb_devices"
        sb_paths allow 'file-write*' subpath "${writable[@]}"
        sb_denied=("${sb_homes[@]}")
        sb_paths deny 'file-read*' subpath "${sb_denied[@]}"
        sb_paths allow 'file-read*' subpath "${writable[@]}" "${readable[@]}"
        sb_ancestors "${writable[@]}" "${readable[@]}"
        bin=$(real_path "$toolchain")/bin
        build_env=(HOME="$rwork/build-home" TMPDIR="$rwork/tmp" PATH="$bin:/usr/bin:/bin"
            LANG="${LANG:-C.UTF-8}" CARGO_HOME="$rwork/cargo-home" RUSTC="$bin/rustc")
        [[ -z ${TERM:-} ]] || build_env+=(TERM="$TERM")
        inside=$rwork/target
        say "building takt at ${sha:0:12} in $work for $host, confined in sandbox-exec"
        (close_inherited && cd "$rwork/src" && exec env -i "${build_env[@]}" /usr/bin/perl -e "$reaper" 0 \
            "$confiner" "${sb_args[@]}" -p "$sb_text" "$bin/cargo" build \
            --locked --offline --config "build.target=\"$host\"" --message-format=json \
            -p b10x-takt-cli --bin takt --target-dir "$inside" </dev/null >"$work/messages") ||
            fail "takt does not build at ${sha:0:12}, confined in sandbox-exec"
    else
        inside=/target
        # The sandbox of `takt promote`'s build (crates/takt/src/promotion.rs, `Confinement`): the
        # system directories and /etc read-only, its own /proc, /dev, /tmp and HOME, the toolchain
        # read-only at /toolchain, and the checkout, the target directory and a scratch CARGO_HOME,
        # the caller's caches read-only under it, the only paths bound writable.
        sandbox=("$bwrap" --unshare-pid --unshare-net --die-with-parent --clearenv
            --setenv HOME /build-home --setenv TMPDIR /tmp
            --setenv PATH /toolchain/bin:/usr/bin:/bin --setenv LANG "${LANG:-C.UTF-8}"
            --setenv CARGO_HOME /cargo-home --setenv RUSTC /toolchain/bin/rustc)
        [[ -z ${TERM:-} ]] || sandbox+=(--setenv TERM "$TERM")
        sandbox+=(--ro-bind /usr /usr)
        for dir in /lib /lib64 /bin /sbin; do
            if [[ -L $dir ]]; then
                sandbox+=(--symlink "$(readlink -- "$dir")" "$dir")
            elif [[ -d $dir ]]; then
                sandbox+=(--ro-bind "$dir" "$dir")
            fi
        done
        sandbox+=(--ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp --tmpfs /build-home
            --ro-bind "$toolchain" /toolchain
            --bind "$work/src" /work --bind "$work/target" /target
            --bind "$work/cargo-home" /cargo-home)
        for dir in registry/cache registry/index git/db git/checkouts; do
            if [[ -d $cached/$dir ]]; then
                sandbox+=(--ro-bind "$cached/$dir" "/cargo-home/$dir")
            fi
        done
        say "building takt at ${sha:0:12} in $work for $host, confined in bwrap"
        (close_inherited && exec "${sandbox[@]}" --chdir /work -- /toolchain/bin/cargo build \
            --locked --offline --config "build.target=\"$host\"" --message-format=json \
            -p b10x-takt-cli --bin takt --target-dir /target </dev/null >"$work/messages") ||
            fail "takt does not build at ${sha:0:12}, confined in bwrap"
    fi
    built=()
    while IFS= read -r line; do
        [[ $line == '{"reason":"compiler-artifact",'* ]] || continue
        [[ $line == *'"target":{"kind":["bin"],'*'"name":"takt",'* ]] || continue
        [[ $line =~ \"package_id\":\"[^\"]*b10x-takt-cli[@#\ ] ]] || continue
        if [[ -n $darwin ]]; then
            [[ $line =~ \"executable\":\"([^\"]+)\" ]] || continue
            exe=${BASH_REMATCH[1]}
            [[ $exe == "$inside"/* && ${exe#"$inside"/} =~ ^[A-Za-z0-9_./-]+/takt$ ]] || continue
            [[ /${exe#"$inside"/}/ != */../* ]] && built+=("$exe")
        else
            [[ $line =~ \"executable\":\"(/target/[A-Za-z0-9_./-]+/takt)\" ]] || continue
            [[ /${BASH_REMATCH[1]}/ != */../* ]] && built+=("${BASH_REMATCH[1]}")
        fi
    done <"$work/messages"
    ((${#built[@]} == 1)) ||
        fail "cargo reported ${#built[@]} takt binaries under $inside at ${sha:0:12}, not one"
    [[ -f $work/target/${built[0]#"$inside"/} && ! -L $work/target/${built[0]#"$inside"/} ]] ||
        fail "cargo reported ${built[0]}, which the build directory does not hold as a file"
    mkdir -p "$root/builds/$sha"
    cp "$work/target/${built[0]#"$inside"/}" "$takt.$$"
    mv -f "$takt.$$" "$takt"
    printf '%s\n' "$sha" >"$root/builds/$sha/revision.$$"
    mv -f "$root/builds/$sha/revision.$$" "$root/builds/$sha/revision"
    rm -rf -- "$work"
    trap - EXIT
fi

# The predicate's home: fresh, the check's own.
home=$run/home
mkdir -p "$home/.cache/aep"
sources=${XDG_CACHE_HOME:-}
[[ $sources == /* ]] || sources=$HOME/.cache
sources=$sources/aep/protocol-sources
# Neither a link nor a copy: the command runs under bubblewrap with the caller's protocol
# sources bound read-only at `.cache/aep/protocol-sources` of this home, so a write through
# them fails and the caller's cache stays as it was. The directory is the mount point; on the
# host it stays empty.
# On macOS, where nothing is bound, `.cache/aep/protocol-sources` of this home is a link to
# their real path, which the profile lets the command read and not write.
bound=$home/.cache/aep/protocol-sources
binds=()
if [[ -d $sources && -n $darwin ]]; then
    ln -s "$(real_path "$sources")" "$bound"
elif [[ -d $sources ]]; then
    mkdir -p "$bound"
    binds=(--ro-bind "$sources" "$bound")
fi

# The starting state: a clone of the scenario repository, or of the predicate's repository, on
# `trial/0` at the seed, with no remote, so nothing the predicate does reaches the repository
# it was cloned from. The clone, and every git call that sets it up, runs as the predicate will,
# not as the caller: with the environment replaced (`env -i`; `env VAR=… git` would add to the
# caller's, whose `GIT_CONFIG_*` or `GIT_CONFIG_PARAMETERS` `insteadOf` could send a public URL
# to a private repository, whose `GIT_ASKPASS` or `GIT_SSH_COMMAND` would run with its secrets,
# and whose `GIT_DIR` would redirect every `git -C`), in the fresh HOME, with no system or
# global git configuration, no credential helper, no ssh command, no askpass and no prompt, so
# a repository that wants a credential fails rather than being read with the caller's; without
# hardlinks, so a predicate that damages an object in its clone damages nothing in the
# repository it was cloned from; and dissociated, so a source that borrows its objects (a
# `--checkout` that is itself a `--shared` clone) lends the clone no `objects/info/alternates`.
clone_git() {
    env -i PATH="$PATH" HOME="$home" LANG="${LANG:-C.UTF-8}" \
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
        git -c credential.helper= -c core.sshCommand=false -c core.askPass= "$@"
}
clone=$run/scenario
clone_git clone --quiet --no-checkout --no-hardlinks --dissociate -- "$source" "$clone" >&2 ||
    fail "clone $source"
resolved=$(clone_git -C "$clone" rev-parse --verify --quiet "$seed^{commit}") ||
    fail "$where: the seed ${seed:0:12} is reachable from no branch of $source"
seed=$resolved
# `-B`: the clone's one local branch is the one the checkout was on, `trial/0` when a scenario
# run left it there; it is set to the seed whatever it held.
clone_git -C "$clone" checkout --quiet -B trial/0 "$seed" >&2 || fail "check out the seed ${seed:0:12}"
clone_git -C "$clone" remote remove origin
clone_git -C "$clone" config user.name check-finding
clone_git -C "$clone" config user.email check-finding@example.invalid

say "$finding: $where, takt at ${sha:0:12}: $command"
environment=(PATH="$PATH" HOME="$home" LANG="${LANG:-C.UTF-8}" TAKT="$takt" SCENARIO="$clone")
[[ -z $test_command ]] || environment+=(TEST="$test_command")
# The caller's home and the user's passwd home, hidden from the command (`hide_homes`).
hide_homes
if [[ -n $darwin ]]; then
    # The run step's profile on macOS. No network: no TCP, and no unix socket of the user's
    # session, its agents, the container engines or the system bus. Writes only to the
    # devices, the clone, the predicate's home and this user's temporary and cache
    # directories; the run directory around them, where the check keeps the predicate, the
    # command's output and the result, is not written, so the command plants no link the check
    # would write through. Nothing read under the hidden homes, `/tmp` or `/var/run` (whose
    # sockets, X11's and docker's among them, are not even in sight) but the clone, the home,
    # the kept binary and the caller's protocol sources, and the directories above them looked
    # up. `-D STEP=run` names the step to a stand-in for sandbox-exec; no rule reads it.
    r_clone=$(real_path "$clone")
    r_home=$(real_path "$home")
    r_takt=$(real_path "$takt")
    seen=("$r_clone" "$r_home")
    [[ ! -d $sources ]] || seen+=("$(real_path "$sources")")
    # The command reaches the binary, the clone and its home by their real paths: a link on the
    # way to the cache (an operator's `<cache>/takt` to another directory) lies under no path the
    # profile lets it read, so `$TAKT` named through it could not be run.
    environment=(PATH="$PATH" HOME="$r_home" LANG="${LANG:-C.UTF-8}" TAKT="$r_takt" SCENARIO="$r_clone")
    [[ -z $test_command ]] || environment+=(TEST="$test_command")
    sb_reset
    sb_rule '(deny network*)'
    sb_rule '(deny file-write*)'
    sb_rule "$sb_devices"
    sb_paths allow 'file-write*' subpath "$r_clone" "$r_home" ${darwin_dirs[@]+"${darwin_dirs[@]}"}
    sb_denied=("${sb_homes[@]}" /private/tmp /private/var/run)
    sb_paths deny 'file-read*' subpath "${sb_denied[@]}"
    sb_paths allow 'file-read*' subpath "${seen[@]}"
    sb_paths allow 'file-read*' literal "$r_takt"
    sb_ancestors "${seen[@]}" "$r_takt"
    # The status pipe (fd 3) is the inner `sh`'s alone: the command runs with it closed, so
    # neither it nor a process it leaves writes the line read below.
    wrapper='sh -c "$1" 3>&-; s=$?; printf "{ \"exit-code\": %d }\n" "$s" >&3; exit "$s"'
    set +e
    reported=$(close_inherited && cd "$clone" && env -i "${environment[@]}" /usr/bin/perl -e "$reaper" "$limit" \
        "$confiner" -D STEP=run "${sb_args[@]}" -p "$sb_text" /bin/sh -c "$wrapper" sh "$command" \
        3>&1 >"$run/output" 2>&1 </dev/null)
    status=$?
    set -e
    ((status != 124)) || fail "the command ran past $limit seconds"
    ended=$(printf '%s\n' "$reported" | tail -n 1 | sed -n 's/^{ *"exit-code": *\([0-9][0-9]*\) *}$/\1/p')
    if [[ -z $ended ]] || ((10#$ended != status)); then
        error=$({ grep '^sandbox-exec: ' "$run/output" || true; } | tail -n 1)
        fail "sandbox-exec did not run the command to its end (exit $status${ended:+, the command ended $ended}): ${error:-sandbox-exec printed no error}"
    fi
else
    # The run step's sandbox. Every host path read-only (`--ro-bind / /`) but two, bound writable
    # at their paths: the clone and the predicate's home. The run directory around them, where the
    # check keeps the predicate, the command's output and the result, is not, so the command
    # plants no link the check would write through. Devices, /proc, /tmp and /run of its own
    # (`/var/run` too where it is a directory and no link to /run): no socket of the user's
    # session, its agents, the container engines or the system bus under them is in sight. The
    # homes above, each an empty read-only directory (a tmpfs, remounted read-only once the paths
    # below are bound into it), so nothing under them is read and a write there fails, or finds no
    # such path. The kept binary and the caller's protocol sources bound read-only at the paths
    # they have on the host, which may lie under a hidden home, and the sources once more at the
    # predicate's home (`binds`). Its own network namespace (`--unshare-net`): no network, and no
    # abstract unix socket of the host (X11's among them); its own IPC namespace
    # (`--unshare-ipc`); its own PID namespace (`--unshare-pid`): when the command ends, bwrap's
    # init, pid 1 there, ends, and the kernel kills every process the command left, so none
    # outlives the check. The caller's user stays as it is. `--die-with-parent`, so the command
    # dies with bwrap when `timeout` kills it. bwrap clears nothing of the environment `env -i`
    # gives it.
    sandbox=("$bwrap" --die-with-parent --unshare-pid --unshare-net --unshare-ipc --json-status-fd 3
        --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --tmpfs /run)
    [[ -L /var/run || ! -d /var/run ]] || sandbox+=(--tmpfs /var/run)
    for dir in "${hidden[@]}"; do
        sandbox+=(--tmpfs "$dir")
    done
    sandbox+=(--bind "$clone" "$clone" --bind "$home" "$home" --ro-bind "$takt" "$takt")
    [[ ! -d $sources ]] || sandbox+=(--ro-bind "$sources" "$sources")
    sandbox+=(${binds[@]+"${binds[@]}"})
    for dir in "${hidden[@]}"; do
        sandbox+=(--remount-ro "$dir")
    done
    sandbox+=(--chdir "$clone")
    # bwrap's status reaches the check on a pipe (fd 3, standard output of the substitution),
    # never a file on disk another process could write; bwrap keeps that descriptor to its own
    # process outside the namespace (bubblewrap 0.12.0: neither the command nor pid 1 holds it).
    # It writes `{ "child-pid": … }` once it has forked, before its mount setup, and its last line,
    # `{ "exit-code": N }`, only once the setup held, `sh` started and then ended with N: a mount
    # that fails, or an exec that fails, leaves no such line and exits 1, a status a predicate may
    # name. So the command's exit is bwrap's status only when the last line is `exit-code` and N
    # is that status; else bwrap did not run the command to its end, and there is no result. N
    # says how `sh -c` ended, nothing of what the command did on the way.
    set +e
    reported=$(close_inherited && cd "$clone" && env -i "${environment[@]}" timeout --kill-after=10 "$limit" \
        "${sandbox[@]}" -- sh -c "$command" 3>&1 >"$run/output" 2>&1 </dev/null)
    status=$?
    set -e
    ((status != 124 && status != 137)) || fail "the command ran past $limit seconds"
    ended=$(printf '%s\n' "$reported" | tail -n 1 | sed -n 's/^{ *"exit-code": *\([0-9][0-9]*\) *}$/\1/p')
    if [[ -z $ended ]] || ((10#$ended != status)); then
        error=$({ grep '^bwrap: ' "$run/output" || true; } | tail -n 1)
        fail "bubblewrap did not run the command to its end (exit $status${ended:+, the command ended $ended}): ${error:-bubblewrap printed no error}"
    fi
fi

# The result. `reproduced` needs every expectation the predicate gives and an exit it names:
# its `exit`, or with none its `healthy_exit`. `not_reproduced` needs the healthy exit, the one
# status that says the command ran to the scenario and the defect is gone; any other status (a
# panic's 101, a rejected flag's 2, a command not found's 127, the defect's exit without its
# output) is `error`, which verifies nothing.
healthy_exit=$(predicate_value healthy_exit) || healthy_exit=
healthy=$((10#${healthy_exit:-0}))
named=$healthy
if exit_named=$(predicate_value exit); then
    named=$((10#$exit_named))
fi
held=1
((status == named)) || held=0
expected_output= output_named=
if expected_output=$(predicate_value output); then
    output_named=1
    grep -qF -- "$expected_output" "$run/output" || held=0
fi
if ((held)); then
    result=reproduced
elif ((status == healthy)); then
    result=not_reproduced
else
    result=error
    say "exit $status, which the predicate names as neither the defect's with all its expectations (exit $named${output_named:+, output \`$expected_output\`}) nor the healthy one (healthy_exit $healthy): the command did not show the defect, nor that it is gone"
fi
{
    printf 'finding: %s\nrevision: %s\n' "$finding" "$sha"
    if [[ -n $scenario ]]; then
        printf 'scenario: %s\nstory: %s\n' "$scenario" "$story"
    else
        printf 'repository: %s\n' "$repository"
        [[ -z $checkout ]] || printf 'checkout: %s\n' "$checkout"
        [[ -z $test_command ]] || printf 'test: %s\n' "$test_command"
    fi
    printf 'seed: %s\nhealthy_exit: %s\nexit: %s\nresult: %s\n' "$seed" "$healthy" "$status" "$result"
} >"$run/result"
say "exit $status; $result"
printf '%s\n' "$result"
