#!/usr/bin/env bash
# check-finding: run a filed finding's `expected_before` predicate on its scenario with a takt
# built from a given revision, and print whether the defect is there.
#
#   check-finding [--scenarios <repo>] [--declared-on <rev>] [--checkout <url>=<path>]...
#                 [--repo <dir>] <finding> <revision>
#
#   <finding>        the finding's artifact id in this repository's planning store, as
#                    `scripts/file-finding` filed it (`story:<key>` or `blocker:<key>`)
#   <revision>       the takt revision to build, resolved in this repository; the promoted
#                    revision for the baseline, the candidate's for a fix
#   --scenarios      a checkout of the scenario repository, required for a predicate that names
#                    a `scenario`; it is only read: the predicate runs in a clone of it. A
#                    predicate that names its `repository` ignores it
#   --declared-on    the revision of the scenario repository whose `.engineering/scenarios.conf`
#                    declares the scenario (`[scenario "<id>"]`, `story` and `seed`); `main`
#   --checkout       for a predicate that names its `repository`: a local checkout that stands in
#                    for that `https://` URL, cloned instead of it (speed, or no network);
#                    repeatable, one URL each. The predicate itself never names a path: it is
#                    committed to a public repository and must hold on every machine
#   --repo           this repository; the top of the tree the script is run in
#
# Steps: the finding's file is read from the store (`.engineering/planning/<kind>/<name>.md`,
# read only, so the check needs no `aep`) and its predicate parsed by
# `scripts/file-finding --predicate`. A predicate names a `scenario`, whose declaration is read
# from `--declared-on` with `git config --no-includes --blob`, as `takt scenario run` reads it;
# or a `repository` (an `https://` URL) with the `seed` the task starts from and, optionally,
# the task's `test` command. The revision is checked out into a build directory
# of its own under the cache (a clone of this repository holding its own copy of the objects,
# so a commit no branch holds builds too) and built with `cargo build --locked --offline`,
# confined in bubblewrap (`bwrap`, on PATH) as `takt promote` builds a candidate
# (crates/takt/src/promotion.rs): the environment cleared but for HOME, TMPDIR, PATH, LANG,
# TERM when set, CARGO_HOME and RUSTC; an empty HOME and /tmp of its own; its own process and
# network namespaces; the system directories and the toolchain read-only, the toolchain
# rustup's default (`default_toolchain` in `$RUSTUP_HOME/settings.toml`, `~/.rustup` without
# it), its own `cargo` and `rustc` called, never a proxy on PATH; a scratch CARGO_HOME with the
# caller's registry and git caches (`$CARGO_HOME`, `~/.cargo` without it) read-only under it;
# and the checkout, the target directory and that CARGO_HOME, all three inside the build
# directory, the only paths it can write. So a revision's `build.rs`, proc macros and
# `.cargo/config.toml` read nothing of the caller's environment or home and write nothing
# outside the build directory, another revision's kept binary among it; without bubblewrap the
# check builds nothing. The target is the host's (`--config build.target=<host>`, over the
# revision's configuration), and the binary kept is the one cargo reports building (the
# `executable` of its JSON message for the `takt` bin), never a file the revision commits where
# a build would put it. The binary is kept per revision beside a
# `revision` file naming the commit it was built from, and the build directory removed. A build
# is made in a checkout, never from an export, so the binary's `--version` and its runs' `opened`
# records name the revision; a kept binary with no `revision` file beside it predates that and is
# built again. The scenario repository, or the predicate's repository (the checkout `--checkout`
# gives for its URL, else the URL itself), is cloned by a git that runs as the predicate will,
# not as the caller: its environment replaced (`env -i`) by PATH, LANG and the fresh HOME below,
# so no `GIT_CONFIG_*`, `GIT_CONFIG_PARAMETERS`, `GIT_DIR`, `GIT_ASKPASS`, `GIT_SSH_COMMAND` or
# agent socket of the caller reaches it, with no system or global configuration, no credential
# helper, no ssh command, no askpass and no prompt (`GIT_TERMINAL_PROMPT=0`: a repository that
# wants a credential fails, it does not ask), without hardlinks, and dissociated from any
# repository its source borrows objects from. The clone's `trial/0` is set to the seed (whatever
# branch the checkout was on) and checked out and its remote removed, by that same git; then the
# predicate's command runs there through `sh -c`, with `$TAKT` the binary, `$SCENARIO` the clone
# and, when the predicate gives one, `$TEST` the task's test command. Its environment holds only
# PATH, LANG, TAKT, SCENARIO, TEST and HOME, and HOME is a fresh directory of the check's own,
# never the caller's, so no credential of the caller reaches it, neither from the environment
# nor from a file a tool reads under HOME (git's credential store, a CLI's login). The command
# runs under bubblewrap with the whole filesystem bound as it is and, over it, the caller's
# cache of the public protocol sources `aep` reads bound read-only at the home's
# `.cache/aep/protocol-sources`, so `aep` needs no network there and a write through it fails;
# bubblewrap adds no other isolation (network, processes and every other path as before), and
# without it no predicate runs. The command still runs as the caller's user: this is
# no sandbox against a path it names outright. The script's own git reads and writes name their
# repository by path, so a `GIT_DIR`, `GIT_WORK_TREE` or `GIT_INDEX_FILE` of the caller (a
# hook's environment) is unset before any of them.
# The cache is `$XDG_CACHE_HOME/takt/check-finding`, `~/.cache/takt/check-finding` without it:
# `builds/<sha>/takt` and `builds/<sha>/revision`, and one directory per check under `runs/`
# holding the finding, the clone, the predicate's home, the command's output and the result,
# kept as the record of the check.
#
# Standard output is one line, the result of the `scenario_result` evidence kind
# (protocols/self-improvement/1.yaml): `reproduced` when every expectation the predicate gives
# held (the exit status, the fixed string in standard output or standard error) and the command
# ended with a status the predicate names (its `exit`, else its `healthy_exit`); else
# `not_reproduced` when the command ended with the predicate's `healthy_exit` (0 when it names
# none), the one status that says the command ran to the scenario and the defect is gone; else
# `error`, the status named on standard error and in the record: a crash, a command that never
# started, a flag rejected, or any status the predicate does not name as the healthy one. An
# `error` verifies nothing. All three exit 0. A check that cannot run its predicate (no such
# finding, a predicate that does not parse, a revision that names no commit, a scenario not
# declared, no bubblewrap or no toolchain for a build, a build that fails, a bubblewrap that
# did not run the command to its end, its error named on standard error, a command past
# CHECK_FINDING_TIMEOUT seconds, 900 by default) prints nothing on standard output and exits 1;
# a usage error, a CHECK_FINDING_TIMEOUT that is no whole number of seconds among them, exits 64.
set -euo pipefail

# The repositories this script reads and writes are the ones it names by path; a GIT_DIR,
# GIT_WORK_TREE or GIT_INDEX_FILE of the caller (a hook's environment) would send every `git -C`
# to another repository, or a checkout into the caller's index.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

say() { printf 'check-finding: %s\n' "$*" >&2; }
usage() {
    say "$*"
    say "usage: check-finding [--scenarios <repo>] [--declared-on <rev>] [--checkout <url>=<path>]... [--repo <dir>] <finding> <revision>"
    exit 64
}
fail() {
    say "$*; no result"
    exit 1
}

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
scenarios= declared_on=main repo=
declare -A checkouts=()
positional=()
while (($#)); do
    case $1 in
    --scenarios | --declared-on | --repo | --checkout)
        (($# >= 2)) || usage "$1 takes a value"
        case $1 in
        --scenarios) scenarios=$2 ;;
        --declared-on) declared_on=$2 ;;
        --repo) repo=$2 ;;
        --checkout)
            [[ $2 == https://?*=?* ]] || usage "--checkout $2: give <https-url>=<path>, the URL a predicate names and the local checkout that stands in for it"
            url=${2%%=*}
            path=${2#*=}
            [[ -z ${checkouts[$url]+x} ]] || usage "--checkout $2: $url is given twice"
            checkouts[$url]=$(cd "$path" 2>/dev/null && pwd -P) || usage "--checkout $2: $path is no directory"
            ;;
        esac
        shift 2
        ;;
    -h | --help)
        sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"
        exit 0
        ;;
    --) shift; positional+=("$@"); break ;;
    -*) usage "unexpected option \`$1\`" ;;
    *) positional+=("$1"); shift ;;
    esac
done
((${#positional[@]} == 2)) || usage "give the finding and the revision"
finding=${positional[0]}
revision=${positional[1]}
if [[ -n $scenarios ]]; then
    scenarios=$(cd "$scenarios" 2>/dev/null && pwd -P) || usage "--scenarios: no directory"
fi
if [[ -z $repo ]]; then
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || usage "not inside a repository; give --repo"
fi
repo=$(cd "$repo" 2>/dev/null && pwd -P) || usage "--repo: no directory"
# Checked before anything runs: `timeout` given no duration it takes exits 125 without running
# the command, which would be read as the predicate's exit.
limit=${CHECK_FINDING_TIMEOUT:-900}
[[ $limit =~ ^[1-9][0-9]{0,5}$ ]] ||
    usage "CHECK_FINDING_TIMEOUT=$limit: give a whole number of seconds, 1 to 999999"
[[ $finding =~ ^([a-z][a-z-]*):([a-z0-9]+(-[a-z0-9]+)*)$ ]] ||
    usage "$finding: a finding is an artifact id, \`<kind>:<name>\`"
finding_file=$repo/.engineering/planning/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}.md

cache=${XDG_CACHE_HOME:-}
[[ $cache == /* ]] || cache=$HOME/.cache
root=$cache/takt/check-finding
mkdir -p "$root/runs" "$root/builds"
run=$(mktemp -d "$root/runs/${finding//[^A-Za-z0-9-]/-}-XXXXXX")
say "record: $run"

# The finding and its predicate, from the store's file, read only.
cd "$repo"
[[ -f $finding_file ]] || fail "the store in $repo holds no $finding"
cp -- "$finding_file" "$run/finding.md"
"$here/file-finding" --predicate "$run/finding.md" >"$run/predicate.tsv" 2>"$run/predicate.err" ||
    fail "$finding: its predicate does not parse: $(tail -n 1 "$run/predicate.err")"
declare -A predicate=()
while IFS=$'\t' read -r key value; do
    predicate[$key]=$value
done <"$run/predicate.tsv"
scenario=${predicate[scenario]:-}
repository=${predicate[repository]:-}
test_command=${predicate[test]:-}
command=${predicate[command]}

# The revision, in this repository.
sha=$(git -C "$repo" rev-parse --verify --quiet "$revision^{commit}") ||
    fail "$revision names no commit in $repo"

# What the predicate runs on: a scenario, as the scenario repository declares it, or the
# repository and seed the predicate names.
story= seed= source=
if [[ -n $scenario ]]; then
    [[ -n $scenarios ]] || usage "--scenarios is required: the predicate names scenario $scenario, which the scenario repository's checkout declares"
    source=$scenarios
    conf=.engineering/scenarios.conf
    git -C "$scenarios" cat-file -e "$declared_on:$conf" 2>/dev/null ||
        fail "$declared_on holds no $conf in $scenarios; the scenarios are declared there"
    # Without includes, as takt reads it (crates/takt/src/git.rs:204): a scenario declared only
    # through an include is none to `takt scenario run`, and an include is never opened. The
    # section `scenario.<id>.` is held to takt's rules (crates/takt-cli/src/main.rs:714-753):
    # `story` and `seed` once each, with a value, and no other key.
    git -C "$scenarios" config --no-includes --blob "$declared_on:$conf" --list -z \
        >"$run/scenarios.list" 2>"$run/scenarios.err" ||
        fail "scenario $scenario: $conf at $declared_on does not read: $(head -n 1 "$run/scenarios.err")"
    declared=
    while IFS= read -r -d '' entry; do
        key=${entry%%$'\n'*}
        [[ $key == "scenario.$scenario."* ]] || continue
        declared=1
        name=${key#"scenario.$scenario."}
        case $name in
        story | seed) ;;
        *) fail "scenario $scenario: $conf at $declared_on gives \`$name\`, which takt does not read; a scenario gives \`story\` and \`seed\`" ;;
        esac
        value=
        [[ $entry == *$'\n'* ]] && value=${entry#*$'\n'}
        value=${value#"${value%%[![:space:]]*}"}
        value=${value%"${value##*[![:space:]]}"}
        [[ -n $value ]] || fail "scenario $scenario: $conf at $declared_on gives \`$name\` no value"
        [[ -z ${!name} ]] || fail "scenario $scenario: $conf at $declared_on gives \`$name\` twice"
        printf -v "$name" '%s' "$value"
    done <"$run/scenarios.list"
    [[ -n $declared ]] || fail "scenario $scenario: $conf at $declared_on declares no scenario $scenario"
    [[ -n $story ]] || fail "scenario $scenario: $conf at $declared_on gives no \`story\`"
    [[ -n $seed ]] || fail "scenario $scenario: $conf at $declared_on gives no \`seed\`"
    seed=$(git -C "$scenarios" rev-parse --verify --quiet "$seed^{commit}") ||
        fail "scenario $scenario: its seed $seed is no commit in $scenarios"
    where="scenario $scenario ($story at ${seed:0:12})"
else
    [[ -z $scenarios ]] || say "--scenarios is not read: the predicate names its repository, $repository"
    source=$repository
    checkout=
    if [[ -n ${checkouts[$repository]+x} ]]; then
        checkout=${checkouts[$repository]}
        source=$checkout
        say "$repository: cloning the checkout $checkout in its place"
    fi
    seed=${predicate[seed]}
    where="$repository at ${seed:0:12}"
fi
# A --checkout for a URL the predicate does not name stands in for nothing: a mistyped URL
# would otherwise send the check to the network without a word.
for url in "${!checkouts[@]}"; do
    [[ $url == "$repository" ]] ||
        usage "--checkout $url=${checkouts[$url]}: the predicate names ${repository:-no repository}, not $url"
done

# The toolchain a build calls, as `takt promote` resolves it (crates/takt/src/promotion.rs,
# `Confinement::toolchain`): rustup's home (RUSTUP_HOME, else ~/.rustup), the
# `default_toolchain` its settings.toml names, and that toolchain's directory under
# `toolchains/`, by its name or the one directory named by it and a target triple; its
# `bin/cargo` and `bin/rustc` executable and its `lib/rustlib` there. Never one PATH, a
# `rust-toolchain.toml` of the revision or RUSTUP_TOOLCHAIN picks. Prints the directory, or
# says what is missing and fails.
toolchain_dir() {
    local rustup_home=${RUSTUP_HOME:-} settings name line dir found=()
    [[ $rustup_home == /* ]] || rustup_home=$HOME/.rustup
    settings=$rustup_home/settings.toml
    [[ -r $settings ]] ||
        fail "read $settings, rustup's settings, which name the toolchain the build calls; the build finds no toolchain on PATH"
    name=
    while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*default_toolchain[[:space:]]*=[[:space:]]*\"?([^\"[:space:]]*)\"?[[:space:]]*$ ]] || continue
        name=${BASH_REMATCH[1]}
        [[ -n $name ]] && break
    done <"$settings"
    [[ -n $name ]] || fail "$settings names no default_toolchain; the build calls rustup's default toolchain and finds none on PATH"
    [[ $name != */* && $name != .* ]] || fail "$settings: default_toolchain $name is no toolchain name"
    if [[ -d $rustup_home/toolchains/$name ]]; then
        dir=$rustup_home/toolchains/$name
    else
        for dir in "$rustup_home/toolchains/$name"-*; do
            [[ -d $dir ]] && found+=("$dir")
        done
        ((${#found[@]} == 1)) ||
            fail "rustup's default toolchain $name ($settings) matches ${#found[@]} directories under $rustup_home/toolchains, not one"
        dir=${found[0]}
    fi
    [[ -x $dir/bin/cargo && -x $dir/bin/rustc && -d $dir/lib/rustlib ]] ||
        fail "the toolchain $dir (rustup's default, $settings) has no executable bin/cargo and bin/rustc, or no lib/rustlib"
    printf '%s\n' "$dir"
}

# takt, built from the revision in a checkout of its own, once per revision, confined in
# bubblewrap. The checkout is a clone of this repository with its own copy of the objects (no
# hardlink and no alternate into this repository, which the build cannot see), so a revision no
# branch holds still builds and the build's git reads the checkout alone; and a checkout rather
# than an export, so the build script reads the revision into the binary. A kept binary without
# the `revision` file beside it was built from an export, and is replaced.
# Never unconfined: without bubblewrap nothing is built and no predicate runs.
bwrap=$(command -v bwrap) ||
    fail "bubblewrap (\`bwrap\`) is not on PATH; check-finding builds the revision confined in it and runs the predicate under it, never without, so install bubblewrap first"
takt=$root/builds/$sha/takt
if [[ ! -x $takt || ! -f $root/builds/$sha/revision ]]; then
    # Without the toolchain nothing is built.
    toolchain=$(toolchain_dir) || exit 1
    cached=${CARGO_HOME:-}
    [[ $cached == /* ]] || cached=$HOME/.cargo
    work=$(mktemp -d "$root/builds/$sha.work-XXXXXX")
    trap 'rm -rf -- "$work"' EXIT
    mkdir -p "$work/target" "$work/cargo-home"
    git clone --quiet --no-checkout --no-hardlinks --dissociate -- "$repo" "$work/src" >&2 ||
        fail "clone $repo for the build"
    git -C "$work/src" checkout --quiet --detach "$sha" >&2 ||
        fail "check out $sha from $repo"
    # The sandbox of `takt promote`'s build (crates/takt/src/promotion.rs, `Confinement`): the
    # system directories and /etc read-only, its own /proc, /dev, /tmp and HOME, the toolchain
    # read-only at /toolchain, and the checkout, the target directory and a scratch CARGO_HOME,
    # the caller's caches read-only under it, the only paths bound writable.
    sandbox=("$bwrap" --unshare-pid --unshare-net --die-with-parent --clearenv
        --setenv HOME /build-home --setenv TMPDIR /tmp
        --setenv PATH /toolchain/bin:/usr/bin:/bin --setenv LANG "${LANG:-C.UTF-8}"
        --setenv CARGO_HOME /cargo-home --setenv RUSTC /toolchain/bin/rustc)
    [[ -z ${TERM:-} ]] || sandbox+=(--setenv TERM "$TERM")
    sandbox+=(--ro-bind /usr /usr)
    for dir in /lib /lib64 /bin /sbin; do
        if [[ -L $dir ]]; then
            sandbox+=(--symlink "$(readlink -- "$dir")" "$dir")
        elif [[ -d $dir ]]; then
            sandbox+=(--ro-bind "$dir" "$dir")
        fi
    done
    sandbox+=(--ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp --tmpfs /build-home
        --ro-bind "$toolchain" /toolchain
        --bind "$work/src" /work --bind "$work/target" /target
        --bind "$work/cargo-home" /cargo-home)
    for dir in registry/cache registry/index git/db git/checkouts; do
        if [[ -d $cached/$dir ]]; then
            sandbox+=(--ro-bind "$cached/$dir" "/cargo-home/$dir")
        fi
    done
    # The target is the host's whatever the revision's `.cargo/config.toml` says (`--config` on
    # the command line wins over every configuration file; the environment, CARGO_BUILD_TARGET
    # among it, is cleared), and the binary kept is the one cargo reports building: the
    # `executable` of the `compiler-artifact` message for the `takt` bin of b10x-takt-cli,
    # under /target, never a file the revision commits where a build would put it.
    host=$(env -i "$toolchain/bin/rustc" -vV 2>/dev/null | sed -n 's/^host: //p') && [[ -n $host ]] ||
        fail "$toolchain/bin/rustc -vV names no host"
    [[ $host =~ ^[A-Za-z0-9_.-]+$ ]] || fail "$toolchain/bin/rustc names the host \`$host\`, no target triple"
    say "building takt at ${sha:0:12} in $work for $host, confined in bwrap"
    "${sandbox[@]}" --chdir /work -- /toolchain/bin/cargo build --locked --offline \
        --config "build.target=\"$host\"" --message-format=json \
        -p b10x-takt-cli --bin takt --target-dir /target </dev/null >"$work/messages" ||
        fail "takt does not build at ${sha:0:12}, confined in bwrap"
    built=()
    while IFS= read -r line; do
        [[ $line == '{"reason":"compiler-artifact",'* ]] || continue
        [[ $line == *'"target":{"kind":["bin"],'*'"name":"takt",'* ]] || continue
        [[ $line =~ \"package_id\":\"[^\"]*b10x-takt-cli[@#\ ] ]] || continue
        [[ $line =~ \"executable\":\"(/target/[A-Za-z0-9_./-]+/takt)\" ]] || continue
        [[ /${BASH_REMATCH[1]}/ != */../* ]] && built+=("${BASH_REMATCH[1]}")
    done <"$work/messages"
    ((${#built[@]} == 1)) ||
        fail "cargo reported ${#built[@]} takt binaries under /target at ${sha:0:12}, not one"
    [[ -f $work/target/${built[0]#/target/} && ! -L $work/target/${built[0]#/target/} ]] ||
        fail "cargo reported ${built[0]}, which the build directory does not hold as a file"
    mkdir -p "$root/builds/$sha"
    cp "$work/target/${built[0]#/target/}" "$takt.$$"
    mv -f "$takt.$$" "$takt"
    printf '%s\n' "$sha" >"$root/builds/$sha/revision.$$"
    mv -f "$root/builds/$sha/revision.$$" "$root/builds/$sha/revision"
    rm -rf -- "$work"
    trap - EXIT
fi

# The predicate's home: fresh, the check's own.
home=$run/home
mkdir -p "$home/.cache/aep"
sources=${XDG_CACHE_HOME:-}
[[ $sources == /* ]] || sources=$HOME/.cache
sources=$sources/aep/protocol-sources
# Neither a link nor a copy: the command runs under bubblewrap with the caller's protocol
# sources bound read-only at `.cache/aep/protocol-sources` of this home, so a write through
# them fails and the caller's cache stays as it was. The directory is the mount point; on the
# host it stays empty.
bound=$home/.cache/aep/protocol-sources
binds=()
if [[ -d $sources ]]; then
    mkdir -p "$bound"
    binds=(--ro-bind "$sources" "$bound")
fi

# The starting state: a clone of the scenario repository, or of the predicate's repository, on
# `trial/0` at the seed, with no remote, so nothing the predicate does reaches the repository
# it was cloned from. The clone, and every git call that sets it up, runs as the predicate will,
# not as the caller: with the environment replaced (`env -i`; `env VAR=… git` would add to the
# caller's, whose `GIT_CONFIG_*` or `GIT_CONFIG_PARAMETERS` `insteadOf` could send a public URL
# to a private repository, whose `GIT_ASKPASS` or `GIT_SSH_COMMAND` would run with its secrets,
# and whose `GIT_DIR` would redirect every `git -C`), in the fresh HOME, with no system or
# global git configuration, no credential helper, no ssh command, no askpass and no prompt, so
# a repository that wants a credential fails rather than being read with the caller's; without
# hardlinks, so a predicate that damages an object in its clone damages nothing in the
# repository it was cloned from; and dissociated, so a source that borrows its objects (a
# `--checkout` that is itself a `--shared` clone) lends the clone no `objects/info/alternates`.
clone_git() {
    env -i PATH="$PATH" HOME="$home" LANG="${LANG:-C.UTF-8}" \
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
        git -c credential.helper= -c core.sshCommand=false -c core.askPass= "$@"
}
clone=$run/scenario
clone_git clone --quiet --no-checkout --no-hardlinks --dissociate -- "$source" "$clone" >&2 ||
    fail "clone $source"
resolved=$(clone_git -C "$clone" rev-parse --verify --quiet "$seed^{commit}") ||
    fail "$where: the seed ${seed:0:12} is reachable from no branch of $source"
seed=$resolved
# `-B`: the clone's one local branch is the one the checkout was on, `trial/0` when a scenario
# run left it there; it is set to the seed whatever it held.
clone_git -C "$clone" checkout --quiet -B trial/0 "$seed" >&2 || fail "check out the seed ${seed:0:12}"
clone_git -C "$clone" remote remove origin
clone_git -C "$clone" config user.name check-finding
clone_git -C "$clone" config user.email check-finding@example.invalid

say "$finding: $where, takt at ${sha:0:12}: $command"
environment=(PATH="$PATH" HOME="$home" LANG="${LANG:-C.UTF-8}" TAKT="$takt" SCENARIO="$clone")
[[ -z $test_command ]] || environment+=(TEST="$test_command")
# Under bubblewrap only for the bind: the whole filesystem bound as it is, devices included
# (`--dev-bind / /`), then the protocol sources read-only over it; no namespace but the mount
# namespace bwrap needs for that, so the command reaches the network, the processes and every
# path it reached before, as the caller's user. `--die-with-parent`, so the command dies with
# bwrap when `timeout` kills it. bwrap clears nothing of the environment `env -i` gives it.
# Its status file names the command's pid as soon as bwrap forked, before its mount setup, so
# that line proves nothing; the `exit-code` line it writes once the command ended does. Without
# it, or with one that is not the status bwrap exited with, the exit is bwrap's own (a mount
# setup that failed exits 1, the status a predicate may name), not the command's, and there is
# no result.
set +e
(cd "$clone" && env -i "${environment[@]}" timeout --kill-after=10 "$limit" \
    "$bwrap" --die-with-parent --json-status-fd 3 --dev-bind / / "${binds[@]}" --chdir "$clone" \
    -- sh -c "$command" 3>"$run/bwrap-status") \
    >"$run/output" 2>&1 </dev/null
status=$?
set -e
((status != 124 && status != 137)) || fail "the command ran past $limit seconds"
ended=$(sed -n 's/^{ *"exit-code": *\([0-9][0-9]*\) *}$/\1/p' "$run/bwrap-status" | tail -n 1)
if [[ -z $ended ]] || ((10#$ended != status)); then
    error=$({ grep '^bwrap: ' "$run/output" || true; } | tail -n 1)
    fail "bubblewrap did not run the command to its end (exit $status${ended:+, the command ended $ended}): ${error:-bubblewrap printed no error}"
fi

# The result. `reproduced` needs every expectation the predicate gives and an exit it names:
# its `exit`, or with none its `healthy_exit`. `not_reproduced` needs the healthy exit, the one
# status that says the command ran to the scenario and the defect is gone; any other status (a
# panic's 101, a rejected flag's 2, a command not found's 127, the defect's exit without its
# output) is `error`, which verifies nothing.
healthy=$((10#${predicate[healthy_exit]:-0}))
named=$healthy
[[ ! -v predicate[exit] ]] || named=$((10#${predicate[exit]}))
held=1
((status == named)) || held=0
if [[ -v predicate[output] ]] && ! grep -qF -- "${predicate[output]}" "$run/output"; then
    held=0
fi
if ((held)); then
    result=reproduced
elif ((status == healthy)); then
    result=not_reproduced
else
    result=error
    say "exit $status, which the predicate names as neither the defect's with all its expectations (exit $named${predicate[output]+, output \`${predicate[output]}\`}) nor the healthy one (healthy_exit $healthy): the command did not show the defect, nor that it is gone"
fi
{
    printf 'finding: %s\nrevision: %s\n' "$finding" "$sha"
    if [[ -n $scenario ]]; then
        printf 'scenario: %s\nstory: %s\n' "$scenario" "$story"
    else
        printf 'repository: %s\n' "$repository"
        [[ -z $checkout ]] || printf 'checkout: %s\n' "$checkout"
        [[ -z $test_command ]] || printf 'test: %s\n' "$test_command"
    fi
    printf 'seed: %s\nhealthy_exit: %s\nexit: %s\nresult: %s\n' "$seed" "$healthy" "$status" "$result"
} >"$run/result"
say "exit $status; $result"
printf '%s\n' "$result"
